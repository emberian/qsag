# Pending changes to hardware/gf180mcu/src/ for R1 B4 (strap pull-down) and B6 (Schmitt reset pad).
# src/ is outside the paths this lane owns, so these two edits were NOT applied. Apply from
# hardware/gf180mcu with:  patch -p0 < scripts/pending_src_b4_b6.patch
# The RTL fixes in rtl/ do not depend on them: the clock watchdog boots the chip with either strap
# polarity, and the reset pad change is electrical only.
--- src/chip_core.sv
+++ src/chip_core.sv
@@ -3,7 +3,8 @@
 // SLOT_0P5X0P5 (`4.90 mm^2`, `gf180mcuD`, 5.0V `gf180mcu_fd_sc_mcu7t5v0`).
 // Port signature identical to frozen wafer-space/gf180mcu-project-template `chip_core`.
 //
-//   inputs[0]   EXT_CLK_BYPASS (pull-up: 1 = clk_pad is the core clock)
+//   inputs[0]   EXT_CLK_BYPASS (pull-down: 1 = use clk_pad once it is seen running; an
+//               unconnected pad selects the internal oscillator)
 //   inputs[2:1] IO_MODE        (pull-down: 00 = SPI, overridable via CSR[56:54])
 //   inputs[3]   CS_N           (pull-up)
 //   analog[3:0] Unused (zero digital cells wired onto unbuffered asig_5p0 pads)
@@ -42,8 +43,8 @@
     wire        bypass        = input_in[0];
     wire [1:0]  io_mode_strap = input_in[2:1];
     wire        cs_n          = input_in[3];
-    assign input_pu = 4'b1001;
-    assign input_pd = 4'b0110;
+    assign input_pu = 4'b1000;
+    assign input_pd = 4'b0111;
 
     wire        clk_core, rst_core_n, srst_n, zeroize;
     wire        fault_glitch, fault_tamper, fault_shield, clk_mon;
--- src/chip_top.sv
+++ src/chip_top.sv
@@ -153,8 +153,9 @@
         .PD     (1'b0)
     );
     
-    // Normal input
-    `gf180mcu_xxx_io__in_c rst_n_pad (
+    // Schmitt trigger with the pad pull-down: a floating or unpowered reset pad reads as
+    // reset asserted (R1 B6); the board drives it high from a reset supervisor
+    `gf180mcu_xxx_io__in_s rst_n_pad (
         `ifdef USE_POWER_PINS
         .DVDD   (DVDD),
         .DVSS   (DVSS),
@@ -166,7 +167,7 @@
         .PAD    (rst_n_PAD),
         
         .PU     (1'b0),
-        .PD     (1'b0)
+        .PD     (1'b1)
     );
 
     generate
