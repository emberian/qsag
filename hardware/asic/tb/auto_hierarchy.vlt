`verilator_config
// Preserve combinational boundaries so event-driven simulation evaluates a
// generated arithmetic cone only when one of its actual operands changes.
hier_block -module "qsag_gl64_mul_csa"
hier_block -module "qsag_p2_me"
hier_block -module "qsag_p2_mi_apply"
hier_block -module "qsag_p2_mi_tail"
hier_block -module "qsag_p2_canopy_ff"
hier_block -module "qsag_gf128_mul"
hier_block -module "qsag_tower128_to_poly"
hier_block -module "qsag_poly_to_tower128"
// Temporary wires emitted by Verilator in its own hierarchical DPI wrappers.
lint_off -rule UNUSEDSIGNAL -file "*/Vqsag_*/qsag_*.sv" -match "*last_combo_seqnum__V*"
