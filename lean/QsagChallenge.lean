    (CK : Nat) (keyDec : Fin CK → Tower128 × Tower128)
    (hKeyInj : ∀ i j, keyDec i = keyDec j → i = j)
    (Cs : Nat) (prg : Fin Cs → TsigPadTape R pp.d pp.k)
