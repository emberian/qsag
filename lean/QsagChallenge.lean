        RoundPoly.evalCoeffs coeffs zero)
    (corruptVk : Nat → BdozVerifierKeys) (corruptTags : Nat → Tower128 × Tower128)
    (sk : SK) (m : Msg) (approvers : List Nat) (Adv : TsigAdversary R Sig pp.k)
