/-- The labels that two or more crates use on purpose. Hand-maintained in
    `scripts/sync_domain_labels.py` with a reason per entry; the script fails when the labels
    actually shared between crates differ from this list. -/
@[expose] def sharedCrossCrateLabels : List String :=
  ["QSAG.FIRST_SIGNED.V1", "QSAG.HYBRID.V2", "QSAG.MU/v2", "QSAG.POLICY.CTX.V1",
   "QSAG.SEED_BURN.V1", "QSAGFNOD", "QSAGHMS1", "QSAGMRKL", "QSAGPRFM", "QSAGWPK1", "QSAGWPRF",
   "QSAGWSTP"]

-- END GENERATED (scripts/sync_domain_labels.py)

/-- The inventoried labels of one crate (empty for an unknown crate name). -/
@[expose] def auditedLabelsOf (crate : String) : List String :=
  (auditedByteLabels.filter (fun c => c.1 == crate)).flatMap (·.2)

/-- A byte string as a number: its bytes read base 256 after a leading `1`. -/
def bytesCode (bs : List UInt8) : Nat := bs.foldl (fun acc b => acc * 256 + b.toNat) 1

/-- The code of a label's UTF-8 bytes. Equal byte strings have equal codes; nothing below uses
    the converse. -/
def labelCode (s : String) : Nat := bytesCode (bytes s)

/-- The inventory covers these crates, in order. -/
theorem auditedByteLabels_crates :
    auditedByteLabels.map (·.1) =
      ["qsag-accel", "qsag-addr", "qsag-agg", "qsag-asm", "qsag-cli", "qsag-core", "qsag-cred",
       "qsag-fts", "qsag-hd", "qsag-migrate", "qsag-policy", "qsag-quorum",
       "aeneas/qsag-verified"] := by
  decide +kernel

/-- **The generated numbers are the codes of the generated strings**, crate by crate. One UTF-8
    encoding per label; every later comparison is between natural numbers. -/
theorem auditedLabelCodes_eq :
    auditedByteLabels.map (fun c => c.2.map labelCode) = auditedLabelCodes := by
  have h : auditedByteLabels.map (fun c => c.2.map (fun l =>
      l.toByteArray.data.toList.foldl (fun acc b => acc * 256 + b.toNat) 1)) =
      auditedLabelCodes := by
    decide +kernel
  exact h

/-- Within each crate the codes are pairwise distinct. -/
theorem auditedLabelCodes_nodup : ∀ cs ∈ auditedLabelCodes, cs.Nodup := by
  decide +kernel

/-- Every label is between `1` and `64` bytes of UTF-8. -/
theorem auditedByteLabels_lengths :
    ∀ c ∈ auditedByteLabels, ∀ l ∈ c.2, bytes l ≠ [] ∧ (bytes l).length ≤ 64 := by
  unfold bytes
  simp only [String.toUTF8_eq_toByteArray]
  decide +kernel

/-- The cross-crate check as one Boolean: for every two entries with different crate names and
    every pair of their labels, the codes differ, or the labels are equal and allowlisted. -/
def crossCrateCodesOk : Bool :=
  (auditedByteLabels.zip auditedLabelCodes).all fun p₁ =>
    (auditedByteLabels.zip auditedLabelCodes).all fun p₂ =>
      decide (p₁.1.1 = p₂.1.1) ||
      (p₁.1.2.zip p₁.2).all fun lc₁ =>
        (p₂.1.2.zip p₂.2).all fun lc₂ =>
          decide (¬ lc₁.2 = lc₂.2) ||
          (decide (lc₁.1 = lc₂.1) && decide (lc₁.1 ∈ sharedCrossCrateLabels))

theorem crossCrateCodesOk_true : crossCrateCodesOk = true := by
  decide +kernel

/-- **Cross-crate check on codes.** For two inventory entries with different crate names, a
    label of the first and a label of the second with equal codes are the same string, and that
    string is in `sharedCrossCrateLabels`. The strings are compared only where codes coincide. -/
theorem auditedLabelCodes_cross_crate :
    ∀ p₁ ∈ auditedByteLabels.zip auditedLabelCodes,
      ∀ p₂ ∈ auditedByteLabels.zip auditedLabelCodes, p₁.1.1 ≠ p₂.1.1 →
        ∀ lc₁ ∈ p₁.1.2.zip p₁.2, ∀ lc₂ ∈ p₂.1.2.zip p₂.2, lc₁.2 = lc₂.2 →
          lc₁.1 = lc₂.1 ∧ lc₁.1 ∈ sharedCrossCrateLabels := by
  intro p₁ hp₁ p₂ hp₂ hNe lc₁ h₁ lc₂ h₂ hEq
  have h := crossCrateCodesOk_true
  unfold crossCrateCodesOk at h
  have hB := List.all_eq_true.mp (List.all_eq_true.mp h p₁ hp₁) p₂ hp₂
  rcases Bool.or_eq_true_iff.mp hB with hSame | hRest
  · exact absurd (of_decide_eq_true hSame) hNe
  · have hC := List.all_eq_true.mp (List.all_eq_true.mp hRest lc₁ h₁) lc₂ h₂
    rcases Bool.or_eq_true_iff.mp hC with hDiff | hOk
    · exact absurd hEq (of_decide_eq_true hDiff)
    · obtain ⟨hS, hM⟩ := Bool.and_eq_true_iff.mp hOk
      exact ⟨of_decide_eq_true hS, of_decide_eq_true hM⟩

private theorem nodup_of_nodup_map {α β : Type} (f : α → β) :
    ∀ {xs : List α}, (xs.map f).Nodup → xs.Nodup
  | [], _ => List.nodup_nil
  | _ :: _, h =>
    have hc := List.nodup_cons.mp h
    List.nodup_cons.mpr
      ⟨fun hm => hc.1 (List.mem_map_of_mem hm), nodup_of_nodup_map f hc.2⟩

private theorem mem_zip_map_self {α β : Type} (f : α → β) :
    ∀ {xs : List α} {x : α}, x ∈ xs → (x, f x) ∈ xs.zip (xs.map f)
  | [], _, h => nomatch h
  | y :: ys, x, h => by
    rcases List.mem_cons.mp h with rfl | hTl
    · exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (mem_zip_map_self f hTl)

private theorem nodup_map_inj_on {α β : Type} {f : α → β} :
    ∀ {xs : List α}, (xs.map f).Nodup → ∀ {a b : α}, a ∈ xs → b ∈ xs → f a = f b → a = b
  | [], _, _, _, ha, _, _ => nomatch ha
  | x :: xs, hNd, a, b, ha, hb, hEq => by
    obtain ⟨hNotMem, hTail⟩ := List.nodup_cons.mp hNd
    rcases List.mem_cons.mp ha with rfl | haTl
    · rcases List.mem_cons.mp hb with rfl | hbTl
      · rfl
      · exact False.elim (hNotMem (hEq ▸ List.mem_map_of_mem hbTl))
    · rcases List.mem_cons.mp hb with rfl | hbTl
      · exact False.elim (hNotMem (hEq.symm ▸ List.mem_map_of_mem haTl))
      · exact nodup_map_inj_on hTail haTl hbTl hEq

private theorem entry_in_zip {c : String × List String} (hc : c ∈ auditedByteLabels) :
    (c, c.2.map labelCode) ∈ auditedByteLabels.zip auditedLabelCodes := by
  rw [← auditedLabelCodes_eq]
  exact mem_zip_map_self (fun c : String × List String => c.2.map labelCode) hc

private theorem entry_codes_nodup {c : String × List String} (hc : c ∈ auditedByteLabels) :
    (c.2.map labelCode).Nodup := by
  apply auditedLabelCodes_nodup
  rw [← auditedLabelCodes_eq]
  exact List.mem_map_of_mem (f := fun c : String × List String => c.2.map labelCode) hc

/-- Within each crate the inventoried labels are pairwise distinct. -/
theorem auditedByteLabels_nodup : ∀ c ∈ auditedByteLabels, c.2.Nodup :=
  fun _ hc => nodup_of_nodup_map labelCode (entry_codes_nodup hc)

/-- Every inventoried label decodes to a nonempty UTF-8 byte sequence of at most `64` bytes, and
    within each crate the byte sequences `(c.2.map bytes)` are pairwise distinct. -/
theorem auditedByteLabels_bytes_ok :
    ∀ c ∈ auditedByteLabels,
      (c.2.map bytes).Nodup ∧ ∀ l ∈ c.2, bytes l ≠ [] ∧ (bytes l).length ≤ 64 := by
  intro c hc
  refine ⟨nodup_of_nodup_map bytesCode ?_, auditedByteLabels_lengths c hc⟩
  rw [List.map_map]
  exact entry_codes_nodup hc

/-- Two labels of at most `64` nonempty bytes with different byte strings give different
    `cSHAKE256` padded block sequences, for any payloads. -/
private theorem cshake256_ne_of_bytes_ne {l₁ l₂ : String}
    (hB₁ : bytes l₁ ≠ [] ∧ (bytes l₁).length ≤ 64) (hB₂ : bytes l₂ ≠ [] ∧ (bytes l₂).length ≤ 64)
    (hBytesNe : bytes l₁ ≠ bytes l₂) (m₁ m₂ : List UInt8) :
    absorbPayload 136 domCshake256 (cshakePrefix [] (bytes l₁) ++ m₁) ≠
      absorbPayload 136 domCshake256 (cshakePrefix [] (bytes l₂) ++ m₂) := by
  obtain ⟨hNeNil₁, hLen₁⟩ := hB₁
  obtain ⟨hNeNil₂, hLen₂⟩ := hB₂
  have hN : 8 * ([] : List UInt8).length < 256 ^ 255 := by decide +kernel
  have hBnd64 : 8 * 64 < 256 ^ 255 := by decide +kernel
  have hS₁ : 8 * (bytes l₁).length < 256 ^ 255 :=
    Nat.lt_of_le_of_lt (Nat.mul_le_mul_left 8 hLen₁) hBnd64
  have hS₂ : 8 * (bytes l₂).length < 256 ^ 255 :=
    Nat.lt_of_le_of_lt (Nat.mul_le_mul_left 8 hLen₂) hBnd64
  have hDisj := cshake256_encodings_ne m₁ m₂ hN hS₁ hN hS₂
    (fun hPair => hBytesNe (Prod.mk.inj hPair).2)
  simpa [hNeNil₁, hNeNil₂] using hDisj

/-- **Crate-Local `cSHAKE256` Padded-Block Separation (`auditedByteLabels_cshake256_encodings_ne`)**:
    For any crate entry `c ∈ auditedByteLabels`, any two distinct labels `l₁, l₂ ∈ c.2` (`l₁ ≠ l₂`),
    and any payloads `m₁, m₂`, their complete 136-byte `cSHAKE256` padded block sequences are unequal. -/
theorem auditedByteLabels_cshake256_encodings_ne
    {c : String × List String} (hc : c ∈ auditedByteLabels)
    {l₁ l₂ : String} (hl₁ : l₁ ∈ c.2) (hl₂ : l₂ ∈ c.2) (hNe : l₁ ≠ l₂)
    (m₁ m₂ : List UInt8) :
    absorbPayload 136 domCshake256 (cshakePrefix [] (bytes l₁) ++ m₁) ≠
      absorbPayload 136 domCshake256 (cshakePrefix [] (bytes l₂) ++ m₂) := by
  obtain ⟨hMapNd, hBounds⟩ := auditedByteLabels_bytes_ok c hc
  exact cshake256_ne_of_bytes_ne (hBounds l₁ hl₁) (hBounds l₂ hl₂)
    (fun hEq => hNe (nodup_map_inj_on hMapNd hl₁ hl₂ hEq)) m₁ m₂

/-- Labels of two different crates with the same bytes are one label of the allowlist. -/
theorem auditedByteLabels_cross_crate_bytes_eq
    {c₁ c₂ : String × List String} (h₁ : c₁ ∈ auditedByteLabels) (h₂ : c₂ ∈ auditedByteLabels)
    (hCrate : c₁.1 ≠ c₂.1) {l₁ l₂ : String} (hl₁ : l₁ ∈ c₁.2) (hl₂ : l₂ ∈ c₂.2)
    (hBytes : bytes l₁ = bytes l₂) : l₁ = l₂ ∧ l₁ ∈ sharedCrossCrateLabels :=
  auditedLabelCodes_cross_crate _ (entry_in_zip h₁) _ (entry_in_zip h₂) hCrate
    (l₁, labelCode l₁) (mem_zip_map_self labelCode hl₁)
    (l₂, labelCode l₂) (mem_zip_map_self labelCode hl₂) (congrArg bytesCode hBytes)

/-- **Cross-Crate Label Disjointness Modulo `sharedCrossCrateLabels`
    (`auditedByteLabels_cross_crate_disjoint_modulo_shared`)**:
    Across distinct crates `c₁.1 ≠ c₂.1` in `auditedByteLabels`, any label `l ∈ c₁.2 ∩ c₂.2`
    belongs to the explicit `sharedCrossCrateLabels` allowlist. -/
theorem auditedByteLabels_cross_crate_disjoint_modulo_shared :
    ∀ c₁ ∈ auditedByteLabels, ∀ c₂ ∈ auditedByteLabels,
      c₁.1 ≠ c₂.1 → ∀ l ∈ c₁.2, l ∈ c₂.2 → l ∈ sharedCrossCrateLabels :=
  fun _ h₁ _ h₂ hCrate _ hl₁ hl₂ =>
    (auditedByteLabels_cross_crate_bytes_eq h₁ h₂ hCrate hl₁ hl₂ rfl).2

/-- **Cross-crate `cSHAKE256` separation modulo the allowlist.** Take a label from each of two
    different crates of the inventory. Unless the two are the same label and that label is in
    `sharedCrossCrateLabels`, their 136-byte `cSHAKE256` padded block sequences differ for all
    payloads. With `auditedByteLabels_cshake256_encodings_ne` for labels of one crate, this
    covers every pair of inventoried customizations: the only coincidences are the allowlisted
    labels, used across crates on purpose. This is separation of inputs to the sponge; it says
    nothing about which of the inventoried literals are in fact used as cSHAKE customizations. -/
theorem auditedByteLabels_cross_crate_cshake256_encodings_ne
    {c₁ c₂ : String × List String} (h₁ : c₁ ∈ auditedByteLabels) (h₂ : c₂ ∈ auditedByteLabels)
    (hCrate : c₁.1 ≠ c₂.1) {l₁ l₂ : String} (hl₁ : l₁ ∈ c₁.2) (hl₂ : l₂ ∈ c₂.2)
    (hNotShared : ¬ (l₁ = l₂ ∧ l₁ ∈ sharedCrossCrateLabels)) (m₁ m₂ : List UInt8) :
    absorbPayload 136 domCshake256 (cshakePrefix [] (bytes l₁) ++ m₁) ≠
      absorbPayload 136 domCshake256 (cshakePrefix [] (bytes l₂) ++ m₂) :=
  cshake256_ne_of_bytes_ne (auditedByteLabels_lengths c₁ h₁ l₁ hl₁)
    (auditedByteLabels_lengths c₂ h₂ l₂ hl₂)
    (fun hEq => hNotShared (auditedByteLabels_cross_crate_bytes_eq h₁ h₂ hCrate hl₁ hl₂ hEq))
    m₁ m₂

/-- Instance of the cross-crate hypotheses: the Merkle node tag of `qsag-accel` against a WAL
    tag of `qsag-asm`. -/
theorem cross_crate_separation_witness :
    ∃ c₁ ∈ auditedByteLabels, ∃ c₂ ∈ auditedByteLabels, c₁.1 ≠ c₂.1 ∧
      ∃ l₁ ∈ c₁.2, ∃ l₂ ∈ c₂.2, ¬ (l₁ = l₂ ∧ l₁ ∈ sharedCrossCrateLabels) := by
  refine ⟨_, List.mem_cons_self, auditedByteLabels.getD 3 ("", []), ?_, ?_, ?_⟩
  · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))
  · decide +kernel
  · exact ⟨"QSAGMRKL", by decide +kernel, "QSAGLCK1", by decide +kernel, by decide +kernel⟩

/-- `#tooth` Without the allowlist exception the cross-crate statement is false: `QSAGMRKL` is
    an inventoried label of both `qsag-accel` and `qsag-agg`, with equal bytes. -/
theorem tooth_shared_label_is_in_two_crates :
    ¬ (∀ c₁ ∈ auditedByteLabels, ∀ c₂ ∈ auditedByteLabels, c₁.1 ≠ c₂.1 →
        ∀ l₁ ∈ c₁.2, ∀ l₂ ∈ c₂.2, bytes l₁ ≠ bytes l₂) := by
  intro h
  refine h (auditedByteLabels.getD 0 ("", [])) List.mem_cons_self
    (auditedByteLabels.getD 2 ("", [])) ?_ ?_ "QSAGMRKL" ?_ "QSAGMRKL" ?_ rfl
  · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)
  · decide +kernel
  · decide +kernel
  · decide +kernel

theorem digest5_modular_pair_tooth : ∃ a b : BitVec 256,
    digest5FromBitVec256 a ≠ digest5FromBitVec256 b ∧
    naiveLimb a.toNat = naiveLimb b.toNat :=
  ⟨0, BitVec.ofNat 256 goldilocksPrime, digest5_vs_modular_tooth⟩

/-- Concrete instance of the hypotheses of `checked_preimage_is_transcript_hit`: a consistent
    one-entry transcript of the identity permutation with its compression target. -/
theorem transcript_witness : ∃ p : SimpleEquiv (State Goldilocks) (State Goldilocks),
    ∃ t : List (State Goldilocks × State Goldilocks), ∃ x y : State Goldilocks,
    ∃ target : Goldilocks, Consistent p t ∧ (x, y) ∈ t ∧
      jiveCompress (fun _ => zero) p x = target := by
  let x : State Goldilocks := (zero, zero, zero)
  refine ⟨SimpleEquiv.refl _, [(x, x)], x, x, zero, ?_, by simp, ?_⟩
  · exact (consistent_iff _ _).mpr
      (fun a b h => by have e := List.mem_singleton.mp h; cases e; rfl)
  · rw [jiveCompress_eq]
    exact (congrArg (add zero) (add_zero zero)).trans (add_zero zero)

theorem digest5_collision_reduction (a b : BitVec 256)
    (h : digest5FromBitVec256 a = digest5FromBitVec256 b) : a = b :=
  digest5FromBitVec256_injective h

theorem digest_reduction_witness : ∃ a b : BitVec 256,
    digest5FromBitVec256 a = digest5FromBitVec256 b := ⟨0, 0, rfl⟩

