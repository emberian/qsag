theorem fast_root_accepts :
    verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 2 rootStmt rootPi = true := by
  decide +kernel

theorem fast_root_flip :
    ¬ (verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 2 rootStmt (flipRootCoefficient rootPi) = true) := by
  decide +kernel

theorem fast_ood_flip :
    ¬ (verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 2 rootStmt (flipSecondStageOod rootPi) = true) := by
  decide +kernel

theorem fast_headers :
    checkChildHeaders 1 rootStmt leftStmt rightStmt = true := by
  decide +kernel

theorem fast_left_accepts :
    verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 1 leftStmt leftPi = true := by
  decide +kernel

theorem fast_right_accepts :
    verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 1 rightStmt rightPi = true := by
  decide +kernel

theorem fast_fold_agrees :
    parentFoldAgrees fastEnv.profile fastEnv.cfg natXof56 1 leftStmt rightStmt leftPi rightPi rootPi rootFold = true := by
  decide +kernel

theorem fast_stitch :
    parentStitchCheck fastEnv natXof56 1 rootStmt leftStmt rightStmt leftPi rightPi rootPi rootFold = true := by
  unfold parentStitchCheck
  rw [fast_headers, fast_left_accepts, fast_right_accepts, fast_fold_agrees]
  rfl

theorem fast_child_boundary_flip :
    ¬ (parentStitchCheck fastEnv natXof56 1 rootStmt {leftStmt with hi := leftStmt.hi ^^^ 1}
        rightStmt leftPi rightPi rootPi rootFold = true) :=
  parentStitchCheck_childHi_flip fastEnv natXof56 1 rootStmt leftStmt rightStmt leftPi rightPi rootPi rootFold fast_stitch

theorem inhabited_verifyConcreteIvcRoot_first_row :
    ∃ (prof : AggSigProfile) (cfg : ConcreteIvcConfig) (ro : Spec.Bytes → Spec.Bytes)
      (d : Nat) (s : IvcTreeStatement) (p : FixedShapeWhirProof cfg.params),
      verifyConcreteIvcRoot prof cfg ro d s p = true :=
  ⟨fastEnv.profile, fastEnv.cfg, natXof56, 2, rootStmt, rootPi, fast_root_accepts⟩

theorem inhabited_parentStitchCheck_verifies_both :
    ∃ (env : IvcExtractionContext 1) (ro : Spec.Bytes → Spec.Bytes)
      (d : Nat) (s l r : IvcTreeStatement)
      (pL pR p : FixedShapeWhirProof env.cfg.params) (fold : List Goldilocks),
      parentStitchCheck env ro d s l r pL pR p fold = true :=
  ⟨fastEnv, natXof56, 1, rootStmt, leftStmt, rightStmt, leftPi, rightPi, rootPi, rootFold, fast_stitch⟩

theorem inhabited_depth2_concrete_root_and_stitch :
    ∃ (p pL pR : FixedShapeWhirProof fastEnv.cfg.params) (fold : List Goldilocks),
      verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 2 rootStmt p = true ∧
      parentStitchCheck fastEnv natXof56 1 rootStmt leftStmt rightStmt pL pR p fold = true ∧
      verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 1 leftStmt pL = true ∧
      verifyConcreteIvcRoot fastEnv.profile fastEnv.cfg natXof56 1 rightStmt pR = true := by
  have hb := parentStitchCheck_verifies_both fastEnv natXof56 1 rootStmt leftStmt rightStmt leftPi rightPi rootPi rootFold fast_stitch
  exact ⟨rootPi, leftPi, rightPi, rootFold, fast_root_accepts, fast_stitch, hb.2.1, hb.2.2⟩

#verify_constructive
  fast_root_accepts fast_root_flip fast_ood_flip
  fast_headers fast_left_accepts fast_right_accepts fast_fold_agrees fast_stitch
  fast_child_boundary_flip
