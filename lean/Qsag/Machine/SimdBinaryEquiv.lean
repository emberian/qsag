    ((b >>> (64 * (imm / 16 % 2))).setWidth 64)

def clmul87 (a : BitVec 64) : XmmReg :=
  a.setWidth 128 ^^^ (a.setWidth 128 <<< 1) ^^^ (a.setWidth 128 <<< 2) ^^^ (a.setWidth 128 <<< 7)

theorem clmul64_87 (a : BitVec 64) : clmul64 a 0x87 = clmul87 a := by
  simp [clmul64, xorSum, clmul87]

theorem clmul87_xor (a b : BitVec 64) : clmul87 (a ^^^ b) = clmul87 a ^^^ clmul87 b := by
  simp only [clmul87, BitVec.setWidth_xor, BitVec.shiftLeft_xor_distrib]
  ac_rfl

/-- Literal two-fold reduction in the compiled multiply kernels. -/
def gf2_128_reduce_x128_7_2_1_0 (hi lo : XmmReg) : XmmReg :=
  let t := clmul87 ((hi >>> 64).setWidth 64)
  lo ^^^ (t <<< 64) ^^^ clmul87 (hi.setWidth 64 ^^^ (t >>> 64).setWidth 64)

/-- Independent coefficient-by-coefficient product. -/
def clmul128 (a b : XmmReg) : YmmReg :=
  xorSum 128 fun i => if b.getLsbD i then a.setWidth 256 <<< i else 0

theorem xorSum_add {w : Nat} (m n : Nat) (f : Nat → BitVec w) :
    xorSum (m+n) f = xorSum m f ^^^ xorSum n (fun i => f (m+i)) := by
  induction n with
  | zero => simp [xorSum]
  | succ n ih =>
    change xorSum (m+n) f ^^^ f (m+n) = _
    rw [ih, xorSum, BitVec.xor_assoc]

theorem xorSum_xor {w : Nat} (n : Nat) (f g : Nat → BitVec w) :
    xorSum n (fun i => f i ^^^ g i) = xorSum n f ^^^ xorSum n g := by
  induction n with
  | zero => simp [xorSum]
  | succ n ih =>
    simp only [xorSum, ih]
    apply BitVec.eq_of_getLsbD_eq
    intro i _
    simp only [BitVec.getLsbD_xor]
    cases (xorSum n f).getLsbD i <;> cases (xorSum n g).getLsbD i <;>
      cases (f n).getLsbD i <;> cases (g n).getLsbD i <;> rfl

theorem xorSum_shift {w : Nat} (n k : Nat) (f : Nat → BitVec w) :
    xorSum n (fun i => f i <<< k) = xorSum n f <<< k := by
  induction n with
  | zero => simp [xorSum]
  | succ n ih => simp only [xorSum, ih, BitVec.shiftLeft_xor_distrib]

theorem xorSum_width {w v : Nat} (n : Nat) (f : Nat → BitVec w) :
    xorSum n (fun i => (f i).setWidth v) = (xorSum n f).setWidth v := by
  induction n with
  | zero => simp [xorSum]
  | succ n ih => simp only [xorSum, ih, BitVec.setWidth_xor]

theorem xorSum_congr {w : Nat} (n : Nat) (f g : Nat → BitVec w)
    (h : ∀ i, i < n → f i = g i) : xorSum n f = xorSum n g := by
  induction n with
  | zero => rfl
  | succ n ih => rw [xorSum, xorSum, ih (fun i hi => h i (by omega)), h n (by omega)]

/-- Widening a 64-bit term before a shift below 64 loses no coefficients. -/
theorem widen_clmul_term (a : BitVec 64) (i : Nat) (hi : i < 64) :
    ((a.setWidth 128 <<< i).setWidth 256) = a.setWidth 256 <<< i := by
  apply BitVec.eq_of_getLsbD_eq
  intro j
  simp only [BitVec.getLsbD_setWidth, BitVec.getLsbD_shiftLeft]
  by_cases hj : j < 128
  · have h1 : j < 256 := by omega
    have h2 : j-i < 128 := by omega
    have h3 : j-i < 256 := by omega
    simp_all
  · by_cases hji : j < i
    · omega
    · have hz : a.getLsbD (j-i) = false := BitVec.getLsbD_of_ge _ _ (by omega)
      simp_all

/-- The high and low 64-bit coefficients form an exact XOR decomposition. -/
theorem split128 (a : XmmReg) :
    a.setWidth 256 = (a.setWidth 64).setWidth 256 ^^^
      (((a >>> 64).setWidth 64).setWidth 256 <<< 64) := by
  apply BitVec.eq_of_getLsbD_eq
  intro i
  simp only [BitVec.getLsbD_setWidth, BitVec.getLsbD_xor,
    BitVec.getLsbD_shiftLeft, BitVec.getLsbD_ushiftRight]
  by_cases h0 : i < 64
  · simp [h0, show i < 128 by omega, show i < 256 by omega]
  · by_cases h1 : i < 128
    · simp [h0, h1, show i < 256 by omega, show 64 ≤ i by omega,
        show i-64 < 64 by omega, show i-64 < 256 by omega]
    · have hz : a.getLsbD i = false := BitVec.getLsbD_of_ge _ _ (by omega)
      simp [h0, hz, show ¬i-64 < 64 by omega]

def wideMul64 (a : XmmReg) (b : BitVec 64) : YmmReg :=
  xorSum 64 fun i => if b.getLsbD i then a.setWidth 256 <<< i else 0

theorem wideMul64_split (a : XmmReg) (b : BitVec 64) :
    wideMul64 a b = (clmul64 (a.setWidth 64) b).setWidth 256 ^^^
      ((clmul64 ((a >>> 64).setWidth 64) b).setWidth 256 <<< 64) := by
  unfold wideMul64 clmul64
  rw [← xorSum_width, ← xorSum_width, ← xorSum_shift, ← xorSum_xor]
  apply xorSum_congr
  intro i hi
  split
  · rw [split128, BitVec.shiftLeft_xor_distrib]
    simp only [widen_clmul_term _ i hi]
    rw [← BitVec.shiftLeft_add, ← BitVec.shiftLeft_add, Nat.add_comm 64 i]
  · simp

theorem xor_congr (a b c d : BitVec w) (h : a = b) (h' : c = d) : a ^^^ c = b ^^^ d := by
  rw [h, h']

theorem clmul128_split (a b : XmmReg) :
    clmul128 a b = wideMul64 a (b.setWidth 64) ^^^
      (wideMul64 a ((b >>> 64).setWidth 64) <<< 64) := by
  unfold clmul128 wideMul64
  rw [xorSum_add 64 64, ← xorSum_shift]
  apply xor_congr
  · apply xorSum_congr
    intro i hi
    simp [hi]
  · apply xorSum_congr
    intro i hi
    simp only [BitVec.getLsbD_setWidth, BitVec.getLsbD_ushiftRight,
      hi, decide_true, Bool.true_and]
    split <;> simp [BitVec.shiftLeft_add, Nat.add_comm]

/-- Four selector products reconstruct the 256 coefficients of the independent
schoolbook product. The two middle products occupy the same shifted band. -/
theorem clmul128_eq_four_pclmulqdq (a b : XmmReg) :
    clmul128 a b = (pclmulqdq a b 0x00).setWidth 256 ^^^
      (((pclmulqdq a b 0x01).setWidth 256 ^^^ (pclmulqdq a b 0x10).setWidth 256) <<< 64) ^^^
      ((pclmulqdq a b 0x11).setWidth 256 <<< 128) := by
  rw [clmul128_split, wideMul64_split, wideMul64_split]
  simp only [pclmulqdq, Nat.reduceMod, Nat.reduceDiv, Nat.reduceMul,
    BitVec.ushiftRight_zero, BitVec.shiftLeft_xor_distrib,
    ← BitVec.shiftLeft_add]
  simp only [BitVec.xor_assoc]

/-- Polynomial long division, highest coefficient first. -/
def polynomialRemainderSteps : Nat → YmmReg → YmmReg
  | 0, p => p
  | n+1, p =>
    let i := 128+n
    polynomialRemainderSteps n
      (if p.getLsbD i then p ^^^ ((0x100000000000000000000000000000087 : YmmReg) <<< n) else p)

def polynomialRemainder (p : YmmReg) : XmmReg :=
  (polynomialRemainderSteps 128 p).setWidth 128

/-- The polynomial long-division step is GF(2)-linear. -/
theorem foldStep_xor (p q m : YmmReg) (i : Nat) :
    (if (p ^^^ q).getLsbD i then (p ^^^ q) ^^^ m else p ^^^ q) =
      (if p.getLsbD i then p ^^^ m else p) ^^^
      (if q.getLsbD i then q ^^^ m else q) := by
  simp only [BitVec.getLsbD_xor]
  cases p.getLsbD i <;> cases q.getLsbD i <;> simp
  all_goals
    apply BitVec.eq_of_getLsbD_eq
    intro j _
    simp only [BitVec.getLsbD_xor]
    cases p.getLsbD j <;> cases q.getLsbD j <;> cases m.getLsbD j <;> rfl

theorem remainderSteps_xor (n : Nat) (p q : YmmReg) :
    polynomialRemainderSteps n (p ^^^ q) =
      polynomialRemainderSteps n p ^^^ polynomialRemainderSteps n q := by
  induction n generalizing p q with
  | zero => rfl
  | succ n ih => simp only [polynomialRemainderSteps, foldStep_xor, ih]

theorem remainder_xor (p q : YmmReg) :
    polynomialRemainder (p ^^^ q) = polynomialRemainder p ^^^ polynomialRemainder q := by
  simp only [polynomialRemainder, remainderSteps_xor, BitVec.setWidth_xor]

theorem clmul64_xor_left (a b c : BitVec 64) :
    clmul64 (a ^^^ b) c = clmul64 a c ^^^ clmul64 b c := by
  unfold clmul64
  rw [← xorSum_xor]
  apply xorSum_congr
  intro i _
  split <;> simp [BitVec.shiftLeft_xor_distrib]

def fastRemainder (p : YmmReg) : XmmReg :=
  gf2_128_reduce_x128_7_2_1_0 ((p >>> 128).setWidth 128) (p.setWidth 128)

theorem xor_rearrange8 (a b c d e f g h : BitVec w) :
    ((a ^^^ b) ^^^ (c ^^^ d)) ^^^ ((e ^^^ f) ^^^ (g ^^^ h)) =
      (a ^^^ c ^^^ (e ^^^ g)) ^^^ (b ^^^ d ^^^ (f ^^^ h)) := by ac_rfl

attribute [local irreducible] clmul87

theorem fastRemainder_xor (p q : YmmReg) :
    fastRemainder (p ^^^ q) = fastRemainder p ^^^ fastRemainder q := by
  simp only [fastRemainder, gf2_128_reduce_x128_7_2_1_0, clmul87_xor,
    BitVec.ushiftRight_xor_distrib, BitVec.setWidth_xor,
    BitVec.shiftLeft_xor_distrib]
  exact xor_rearrange8 _ _ _ _ _ _ _ _

theorem xorSum_basis_bits (x : BitVec w) (n j : Nat) (hj : j < w) :
    (xorSum n (fun i => if x.getLsbD i then (1 : BitVec w) <<< i else 0)).getLsbD j =
      (decide (j < n) && x.getLsbD j) := by
  induction n with
  | zero => simp [xorSum]
  | succ n ih =>
    simp only [xorSum, BitVec.getLsbD_xor, ih]
    by_cases he : j = n
    · subst he
      cases hx : x.getLsbD j <;> simp [hj]
    · have hz : (if x.getLsbD n then (1 : BitVec w) <<< n else 0).getLsbD j = false := by
        cases hx : x.getLsbD n
        · simp
        · simp only [↓reduceIte, BitVec.getLsbD_shiftLeft]
          by_cases hlt : j < n
          · simp [hlt]
          · have hne : j - n ≠ 0 := by omega
            simp [hj, hlt, BitVec.getLsbD_one, hne]
      rw [hz]
      have hcmp : decide (j < n + 1) = decide (j < n) := by
        by_cases hlt : j < n
        · simp [hlt, show j < n + 1 by omega]
        · simp [hlt, show ¬ (j < n + 1) by omega]
      rw [hcmp]
      cases (decide (j < n) && x.getLsbD j) <;> rfl

theorem xorSum_basis (x : BitVec w) :
    xorSum w (fun i => if x.getLsbD i then (1 : BitVec w) <<< i else 0) = x := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  rw [xorSum_basis_bits x w i hi]
  simp [hi]

theorem linear_on_sum (f : BitVec w → BitVec v)
    (h0 : f 0 = 0) (hx : ∀ a b, f (a ^^^ b) = f a ^^^ f b)
    (n : Nat) (g : Nat → BitVec w) : f (xorSum n g) = xorSum n (fun i => f (g i)) := by
  induction n with
  | zero => exact h0
  | succ n ih => simp only [xorSum, hx, ih]

/-- Equality of linear maps is reduced to finite coefficient witnesses. -/
theorem linear_basis_ext (f g : BitVec w → BitVec v)
    (f0 : f 0 = 0) (g0 : g 0 = 0)
    (fx : ∀ a b, f (a ^^^ b) = f a ^^^ f b)
    (gx : ∀ a b, g (a ^^^ b) = g a ^^^ g b)
    (basis : ∀ i : Fin w, f ((1 : BitVec w) <<< i.val) = g ((1 : BitVec w) <<< i.val)) (x : BitVec w) : f x = g x := by
  rw [← xorSum_basis x, linear_on_sum f f0 fx, linear_on_sum g g0 gx]
  apply xorSum_congr
  intro i hi
  split
  · exact basis ⟨i, hi⟩
  · rw [f0, g0]

attribute [local semireducible] clmul87

set_option maxRecDepth 60000 in
set_option maxHeartbeats 4000000 in
theorem reduction_basis : ∀ i : Fin 256,
    fastRemainder ((1 : YmmReg) <<< i.val) = polynomialRemainder ((1 : YmmReg) <<< i.val) := by
  decide

/-- Exact polynomial-remainder soundness for all 256-bit inputs. The proof uses
GF(2)-linearity of both algorithms and checks only the 256 monomial columns. -/
theorem gf2_128_reduce_exact (p : YmmReg) :
    gf2_128_reduce_x128_7_2_1_0 ((p >>> 128).setWidth 128) (p.setWidth 128) =
      polynomialRemainder p := by
  have hf : fastRemainder 0#256 = 0#128 := by
    have h := fastRemainder_xor 0 0
    simpa only [BitVec.xor_self] using h
  have hg : polynomialRemainder 0#256 = 0#128 := by
    have h := remainder_xor 0 0
    simpa only [BitVec.xor_self] using h
  exact linear_basis_ext fastRemainder polynomialRemainder hf hg
    fastRemainder_xor remainder_xor reduction_basis p

def lane128 (x : YmmReg) (i : Nat) : XmmReg := (x >>> (128*i)).setWidth 128

def lanes128 (f : XmmReg → XmmReg) (x : YmmReg) : YmmReg :=
  (f (lane128 x 0)).setWidth 256 ||| ((f (lane128 x 1)).setWidth 256 <<< 128)

def lanes64 (f : BitVec 64 → BitVec 64) (x : YmmReg) : YmmReg :=
  xorSum 4 fun i => (f ((x >>> (64*i)).setWidth 64)).setWidth 256 <<< (64*i)

def shuffle32 (x : XmmReg) (imm : Nat) : XmmReg :=
  xorSum 4 fun i => ((x >>> (32 * (imm / 2^(2*i) % 4))).setWidth 32).setWidth 128 <<< (32*i)

def pmovmskb (x : YmmReg) (wide : Bool) : BitVec 32 :=
  xorSum (if wide then 32 else 16) fun i => if x.getLsbD (8*i+7) then 1 <<< i else 0

def pmull (a b : XmmReg) : XmmReg := clmul64 (a.setWidth 64) (b.setWidth 64)
def pmull2 (a b : XmmReg) : XmmReg := clmul64 ((a >>> 64).setWidth 64) ((b >>> 64).setWidth 64)
def eor (a b : XmmReg) : XmmReg := a ^^^ b
/-- ARM EXT: first argument supplies the low bytes of the concatenation. -/
def ext (a b : XmmReg) (imm : Fin 16) : XmmReg :=
  ((a.setWidth 256 ||| (b.setWidth 256 <<< 128)) >>> (8*imm.val)).setWidth 128

inductive VecOp where
  | move | xor | and | leftBytes | rightBytes | left64 | right64
  | shuffle | carryless | broadcast | extract | fromGpr | zeroUpper | mask
  deriving DecidableEq, Repr

structure VecInstr where
  op : VecOp
  wide : Bool := false
  legacy : Bool := false
  dst : Nat := 0
  src : Nat := 0
  rhs : Nat := 0
  imm : Nat := 0
  base : Option Nat := none
  disp : Int := 0
  store : Bool := false
  deriving DecidableEq, Repr

def evalVec (op : VecOp) (a b : YmmReg) (imm : Nat) (wide : Bool := true) : YmmReg :=
  match op with
  | .move => b
  | .xor => a ^^^ b
  | .and => a &&& b
  | .leftBytes => lanes128 (fun x => x <<< (8*imm)) b
  | .rightBytes => lanes128 (fun x => x >>> (8*imm)) b
  | .left64 => lanes64 (fun x => x <<< imm) b
  | .right64 => lanes64 (fun x => x >>> imm) b
  | .shuffle => lanes128 (fun x => shuffle32 x imm) b
  | .carryless =>
      (pclmulqdq (lane128 a 0) (lane128 b 0) imm).setWidth 256 |||
        ((pclmulqdq (lane128 a 1) (lane128 b 1) imm).setWidth 256 <<< 128)
  | .broadcast => lanes64 (fun _ => b.setWidth 64) 0
  | .extract => (lane128 a (imm % 2)).setWidth 256
  | .fromGpr => b.setWidth 64 |>.setWidth 256
  | .zeroUpper => b.setWidth 128 |>.setWidth 256
  | .mask => (pmovmskb b wide).setWidth 256

inductive Instr where
  | vector (v : VecInstr)
  | immediate (dst value : Nat)
  | add (dst : Nat) (value : Int)
  | decrement (dst : Nat)
  | branch (disp : Int)
  | jumpZero (disp : Int)
  | test (left right : Nat)
  | clear (dst : Nat)
  | ret
  deriving DecidableEq, Repr

structure Decoded where
  instr : Instr
  size : Nat
  deriving DecidableEq, Repr

/-- Signed displacement, decoded before address arithmetic. -/
def signed (bits n : Nat) : Int :=
  if n < 2^(bits-1) then n else (n : Int) - (2^bits : Nat)

def readLE (b : ByteCode) (p n : Nat) : Nat :=
  (List.range n).foldr (fun i a => (b.get! (p+i)) + 256*a) 0

/-- Restricted ModRM: registers or base+displacement, no SIB/index/RIP-relative.
Unsupported forms fail closed. -/
def modRM (b : ByteCode) (p rExt bExt : Nat) : Option (Nat × Nat × Option Nat × Int × Nat) := do
  let m ← (b.get? (p))
  let md := m / 64
  let reg := m / 8 % 8 + rExt
  let rm := m % 8 + bExt
  if md == 3 then return (reg, rm, none, 0, p+1)
  if m % 8 == 4 || (md == 0 && m % 8 == 5) then none else do
    let n := if md == 1 then 1 else if md == 2 then 4 else 0
    if p+1+n > b.size then none else
      return (reg, rm, some rm, if n == 0 then 0 else signed (8*n) (readLE b (p+1) n), p+1+n)

/-- VEX and legacy SSE decoder for this SIMD subset; all consumed bytes checked.
No textual disassembly or instruction-name oracle participates in decoding. -/
def decodeVector (b : ByteCode) (pc : Nat) : Option Decoded := do
  let first ← (b.get? (pc))
  let (map, pp, src, wide, legacy, re, be, pos) ←
    if first == 0xc5 then do
      let v ← (b.get? (pc+1))
      pure (1, v % 4, 15 - v / 8 % 16, v / 4 % 2 == 1, false,
        (1-v/128)*8, 0, pc+2)
    else if first == 0xc4 then do
      let v ← (b.get? (pc+1))
      let w ← (b.get? (pc+2))
      if v / 64 % 2 != 1 then none else
        pure (v%32, w%4, 15-w/8%16, w/4%2 == 1, false,
          (1-v/128)*8, (1-v/32%2)*8, pc+3)
    else if first == 0x66 || first == 0xf3 then do
      if (b.get? (pc+1)) != some 0x0f then none else do
        let x ← (b.get? (pc+2))
        if x == 0x3a then pure (3, if first == 0x66 then 1 else 2, 0, false, true, 0, 0, pc+3)
        else pure (1, if first == 0x66 then 1 else 2, 0, false, true, 0, 0, pc+2)
    else none
  let opcode ← (b.get? (pos))
  if map == 1 && opcode == 0x77 && pp == 0 && !legacy && !wide && src == 0 then
    return ⟨.vector {op := .zeroUpper}, pos+1-pc⟩
  let (reg, rm, base, disp, next) ← modRM b (pos+1) re be
  let immNeeded := (map == 1 && (opcode == 0x73 || opcode == 0x70)) ||
    (map == 3 && (opcode == 0x44 || opcode == 0x39))
  let imm ← if immNeeded then (b.get? (next)) else some 0
  let size := next + (if immNeeded then 1 else 0) - pc
  let v : VecInstr := {op := .move, wide := wide, legacy := legacy, dst := reg, src := (if legacy then reg else src), rhs := rm, base := base, disp := disp, imm := imm}
  if map == 1 && pp == 2 && (opcode == 0x6f || opcode == 0x7f) then
    if opcode == 0x7f && base.isNone then
      return ⟨.vector {v with dst := rm, rhs := reg}, size⟩
    else return ⟨.vector {v with store := opcode == 0x7f}, size⟩
  if map == 1 && pp == 1 && opcode == 0xef then
    return ⟨.vector {v with op := .xor}, size⟩
  if map == 1 && pp == 1 && opcode == 0xdb then
    return ⟨.vector {v with op := .and}, size⟩
  if map == 1 && pp == 1 && opcode == 0x70 then
    return ⟨.vector {v with op := .shuffle}, size⟩
  if map == 1 && pp == 1 && opcode == 0xd7 && base.isNone then
    return ⟨.vector {v with op := .mask}, size⟩
  if map == 1 && pp == 1 && opcode == 0x6e && base.isNone &&
      first == 0xc4 && b.get! (pc+2) / 128 == 1 && !wide then
    return ⟨.vector {v with op := .fromGpr}, size⟩
  if map == 2 && pp == 1 && opcode == 0x59 && base.isNone then
    return ⟨.vector {v with op := .broadcast}, size⟩
  if map == 3 && pp == 1 && opcode == 0x44 then
    return ⟨.vector {v with op := .carryless}, size⟩
  if map == 3 && pp == 1 && opcode == 0x39 && base.isNone then
    return ⟨.vector {v with op := .extract, dst := rm, src := reg}, size⟩
  if map == 1 && pp == 1 && opcode == 0x73 && base.isNone then
    let op ← match reg % 8 with
      | 2 => some VecOp.right64 | 6 => some VecOp.left64
      | 3 => some VecOp.rightBytes | 7 => some VecOp.leftBytes | _ => none
    return ⟨.vector {v with op, dst := if legacy then rm else src}, size⟩
  none

def decode (b : ByteCode) (pc : Nat) : Option Decoded := do
  let x ← (b.get? (pc))
  if x == 0xc3 then return ⟨.ret, 1⟩
  if x == 0x31 && (b.get? (pc+1)) == some 0xc0 then return ⟨.clear 0, 2⟩
  if x == 0x85 then
    let m ← b.get? (pc+1)
    if m / 64 == 3 then return ⟨.test (m%8) (m/8%8), 2⟩ else none
  if x == 0x74 then
    let n ← b.get? (pc+1)
    return ⟨.jumpZero (signed 8 n), 2⟩
  if x == 0x75 then
    let n ← (b.get? (pc+1))
    return ⟨.branch (signed 8 n), 2⟩
  if x == 0x0f && (b.get? (pc+1)) == some 0x85 && pc+6 ≤ b.size then
    return ⟨.branch (signed 32 (readLE b (pc+2) 4)), 6⟩
  if (x == 0xb8 || x == 0xb9) && pc+5 ≤ b.size then
    return ⟨.immediate (x-0xb8) (readLE b (pc+1) 4), 5⟩
  if x == 0x48 then
    let y ← (b.get? (pc+1))
    if y == 0xb8 && pc+10 ≤ b.size then
      return ⟨.immediate 0 (readLE b (pc+2) 8), 10⟩
    if y == 0xff && (b.get? (pc+2)) == some 0xc9 then return ⟨.decrement 1, 3⟩
    if y == 0x83 || y == 0x81 then
      let m ← (b.get? (pc+2))
      let n := if y == 0x83 then 1 else 4
      if m / 64 != 3 || pc+3+n > b.size then none else do
        let v := signed (8*n) (readLE b (pc+3) n)
        if m / 8 % 8 == 0 then return ⟨.add (m%8) v, 3+n⟩
        if m / 8 % 8 == 5 then return ⟨.add (m%8) (-v), 3+n⟩
        none
    else none
  else decodeVector b pc

/-- The accepted CT subset never transfers secret vectors to public scalars.
PMOVMSKB is decoded but remains tainted and is not admitted by this checker. -/
def ctInstr : Instr → Bool
  | .vector v => v.op != .mask
  | .test _ _ | .jumpZero _ => false
  | _ => true

/-- A coverage certificate supplies only boundaries, never decoded operations.
Every instruction is independently decoded from the pinned bytes, and branch
targets must be certified boundaries. The final boundary is the symbol size. -/
def checkAt (b : ByteCode) (all : List Nat) (pc next : Nat) : Bool :=
  match decode b pc with
  | none => false
  | some d =>
    ctInstr d.instr && pc < next && pc+d.size == next &&
    (match d.instr with
      | .branch off => all.contains (Int.ofNat next + off).toNat
      | _ => true)

def checkBoundaries (b : ByteCode) (all : List Nat) : List Nat → Bool
  | [] => false
  | [last] => last == b.size
  | pc :: next :: rest => checkAt b all pc next && checkBoundaries b all (next :: rest)

def accepted (b : ByteCode) (offsets : List Nat) : Bool :=
  offsets.head? == some 0 && checkBoundaries b offsets offsets

/-- Public caller context includes the return address and stack pointer. -/
structure PublicState where
  pc : Nat := 0
  gpr : Nat → BitVec 64
  zero : Bool := false
  stopped : Bool := false
  returnPC : Nat := 0

structure SecretState where
  ymm : Nat → YmmReg
  memory : Nat → BitVec 8

structure Observation where
  pc : Nat
  memory : List (Bool × Nat × Nat)
  deriving DecidableEq, Repr

def address (p : PublicState) (base : Nat) (disp : Int) : Nat :=
  (BitVec.ofInt 64 ((p.gpr base).toNat + disp)).toNat

def publicStep (d : Decoded) (p : PublicState) : PublicState :=
  let next := {p with pc := p.pc+d.size}
  match d.instr with
  | .immediate r n => {next with gpr := fun i => if i == r then BitVec.ofNat 64 n else p.gpr i}
  | .clear r => {next with gpr := fun i => if i == r then 0 else p.gpr i, zero := true}
  | .add r n =>
    let v := p.gpr r + BitVec.ofInt 64 n
    {next with gpr := fun i => if i == r then v else p.gpr i, zero := v == 0}
  | .decrement r =>
    let v := p.gpr r - 1
    {next with gpr := fun i => if i == r then v else p.gpr i, zero := v == 0}
  | .branch n => if p.zero then next else {next with pc := (Int.ofNat next.pc + n).toNat}
  | .jumpZero n => if p.zero then {next with pc := (Int.ofNat next.pc + n).toNat} else next
  | .test a b => {next with zero := p.gpr a &&& p.gpr b == 0}
  | .ret => {next with pc := p.returnPC, stopped := true, gpr := fun r => if r == 4 then p.gpr 4 + 8 else p.gpr r}
  | .vector _ => next

def observe (d : Decoded) (p : PublicState) : Observation :=
  ⟨p.pc, match d.instr with
    | .vector v => match v.base with
      | none => []
      | some r => [(v.store, address p r v.disp, if v.wide then 32 else 16)]
    | .ret => [(false, (p.gpr 4).toNat, 8)]
    | _ => []⟩

def secretStep (d : Decoded) (p : PublicState) (s : SecretState) : SecretState :=
  match d.instr with
  | .vector v =>
    if v.op == .zeroUpper then {s with ymm := fun r => (s.ymm r).setWidth 128 |>.setWidth 256}
    else
      let addr := address p (v.base.getD 0) v.disp
      let bytes := if v.wide then 32 else 16
      let b := if v.op == .fromGpr then (p.gpr v.rhs).setWidth 256
        else if v.base.isSome then xorSum bytes (fun i => (s.memory (addr+i)).setWidth 256 <<< (8*i))
        else s.ymm v.rhs
      let value := evalVec v.op (s.ymm v.src) b v.imm v.wide
      if v.store then {s with memory := fun i =>
        if addr ≤ i && i < addr+bytes then ((s.ymm v.dst) >>> (8*(i-addr))).setWidth 8 else s.memory i}
      else
        let result := if v.wide then value else if v.legacy then
          (value.setWidth 128).setWidth 256 ||| ((s.ymm v.dst >>> 128) <<< 128)
          else (value.setWidth 128).setWidth 256
        {s with ymm := fun r => if r == v.dst then result else s.ymm r}
  | _ => s

/-- Fuel bounds execution, not the public iteration count. Rejection is explicit.
All successful steps execute the byte-decoded instruction's value semantics. -/
def execute (b : ByteCode) : Nat → PublicState → SecretState → Option (PublicState × SecretState × List Observation)
  | 0, p, s => some (p, s, [])
  | fuel+1, p, s =>
    if p.stopped then some (p, s, []) else do
      let d ← decode b p.pc
      if !ctInstr d.instr then none else do
        let (p', s', trace) ← execute b fuel (publicStep d p) (secretStep d p s)
        return (p', s', observe d p :: trace)

def publicResult (r : Option (PublicState × SecretState × List Observation)) : Option (Nat × List Observation) :=
  r.map fun (p, _, trace) => (p.pc, trace)

theorem execute_ct_ni (b : ByteCode) (fuel : Nat) (p : PublicState) (s t : SecretState) :
    publicResult (execute b fuel p s) = publicResult (execute b fuel p t) := by
  induction fuel generalizing p s t with
  | zero => rfl
  | succ fuel ih =>
    simp only [execute]
    split
    · rfl
    · cases hd : decode b p.pc with
      | none => rfl
      | some d =>
        change publicResult (if !ctInstr d.instr then _ else _) = publicResult (if !ctInstr d.instr then _ else _)
        split
        · rfl
        · have h := ih (publicStep d p) (secretStep d p s) (secretStep d p t)
          cases hs : execute b fuel (publicStep d p) (secretStep d p s) <;>
            cases ht : execute b fuel (publicStep d p) (secretStep d p t) <;>
            simp_all [publicResult]

/-- Three-product multiply: arbitrary secrets and arbitrary public fuel/count. -/
theorem compiled_gf2_128_pclmul_3way_ct_ni (fuel : Nat) (p : PublicState) (s t : SecretState) :
    publicResult (execute gf2_128_mul_acc_pclmul_code fuel p s) =
    publicResult (execute gf2_128_mul_acc_pclmul_code fuel p t) :=
  execute_ct_ni _ _ _ _ _

theorem compiled_transpose64x256_avx2_ct_ni (fuel : Nat) (p : PublicState) (s t : SecretState) :
    publicResult (execute transpose64x256_avx2_code fuel p s) =
    publicResult (execute transpose64x256_avx2_code fuel p t) :=
  execute_ct_ni _ _ _ _ _

theorem compiled_gf2_128_vpclmul_ct_ni (fuel : Nat) (p : PublicState) (s t : SecretState) :
    publicResult (execute gf2_128_mul_acc_vpclmul_code fuel p s) =
    publicResult (execute gf2_128_mul_acc_vpclmul_code fuel p t) :=
  execute_ct_ni _ _ _ _ _

