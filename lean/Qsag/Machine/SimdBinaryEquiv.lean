def xorSum {w : Nat} (n : Nat) (f : Nat → BitVec w) : BitVec w :=
  match n with
  | 0 => 0
  | k + 1 => xorSum k f ^^^ f k

def clmul64 (a b : BitVec 64) : BitVec 128 :=
