module
/-
# Qsag.Machine.SpirvKernelImages — decoded instruction streams of the two shipped SPIR-V kernels

`decode` projects a SPIR-V 1.5 word image onto the part an evaluator needs: every function as its
basic blocks of numeric `(opcode, operands)` instructions, the integer constants, the integer
widths, array lengths and pointer pointees of the type section, the module-scope variables with
their storage classes, and the `BuiltIn` decorations. `p2` and `ntt` are the projections of
`poseidon2Perm12SpvWords` (`poseidon2_perm12.spv`) and `goldilocksNttSpvWords`
(`goldilocks_ntt.spv`); `p2_decoded` and `ntt_decoded` are checked by the kernel, so the two
literals below are what `decode` computes from the shipped words and nothing else.

The literals are printed by `work/images.py` from the same words; the generator is not trusted.
-/
public import Qsag.Machine.SpirvFixtures
public import Qsag.Machine.SpirvNttFixture
import Qsag.Machine.Tactic.KernelRfl

public section
namespace Qsag.Spv
set_option autoImplicit false
set_option maxRecDepth 65536

/-- One instruction: numeric opcode and operand words, in SPIR-V operand order. -/
structure Inst where
  op : Nat
  args : List Nat
  deriving Repr, DecidableEq

/-- A function: result id, parameter ids, and basic blocks `(label, instructions after the label)`
    in binary order. The first block is the entry block. -/
structure Fn where
  id : Nat
  params : List Nat
  blocks : List (Nat × List Inst)
  deriving Repr, DecidableEq

structure Image where
  entry : Nat := 0
  localSize : List Nat := []
  /-- `OpConstant` of integer type: id and value (two-word literals joined little-endian). -/
  scalars : List (Nat × Nat) := []
  /-- `OpConstantComposite` whose constituents are all integer constants: id and values. -/
  composites : List (Nat × List Nat) := []
  /-- `OpVariable` at module scope: id and storage class. -/
  globals : List (Nat × Nat) := []
  /-- `OpDecorate id BuiltIn kind`. -/
  builtins : List (Nat × Nat) := []
  /-- `OpTypeInt`: type id and width. -/
  widths : List (Nat × Nat) := []
  /-- `OpTypeArray`: type id and length. -/
  arrays : List (Nat × Nat) := []
  /-- `OpTypePointer`: type id and pointee type id. -/
  pointers : List (Nat × Nat) := []
  functions : List Fn := []
  deriving Repr, DecidableEq

private def scan : Nat → List UInt32 → Option (List Inst)
  | _, [] => some []
  | 0, _ :: _ => none
  | fuel + 1, h :: tail =>
    let count := h.toNat / 65536
    if count = 0 then none
    else
      let args := tail.take (count - 1)
      if args.length + 1 = count then
        match scan fuel (tail.drop (count - 1)) with
        | some rest => some (⟨h.toNat % 65536, args.map UInt32.toNat⟩ :: rest)
        | none => none
      else none

private def lookNat {α : Type} (k : Nat) : List (Nat × α) → Option α
  | [] => none
  | (k', v) :: rest => if k' = k then some v else lookNat k rest

private def lookAll (tbl : List (Nat × Nat)) : List Nat → Option (List Nat)
  | [] => some []
  | k :: ks =>
    match lookNat k tbl, lookAll tbl ks with
    | some v, some vs => some (v :: vs)
    | _, _ => none

private def closeFn (f : Fn) : Fn :=
  { f with blocks := (f.blocks.map fun b => (b.1, b.2.reverse)).reverse }

/-- `fn` is the function being read, with its blocks and their instructions in reverse order. -/
private def collect (m : Image) (fn : Option Fn) : List Inst → Option Image
  | [] => match fn with
    | none => some { m with functions := m.functions.reverse }
    | some _ => none
  | i :: rest =>
    match fn, i.op, i.args with
    | none, 54, [_, id, _, _] => collect m (some ⟨id, [], []⟩) rest
    | none, 15, 5 :: id :: _ => collect { m with entry := id } none rest
    | none, 16, [id, 17, x, y, z] =>
      if m.entry = id then collect { m with localSize := [x, y, z] } none rest else none
    | none, 21, [id, width, _] => collect { m with widths := m.widths ++ [(id, width)] } none rest
    | none, 28, [id, _, len] =>
      match lookNat len m.scalars with
      | some n => collect { m with arrays := m.arrays ++ [(id, n)] } none rest
      | none => none
    | none, 32, [id, _, pointee] =>
      collect { m with pointers := m.pointers ++ [(id, pointee)] } none rest
    | none, 43, [_, id, lo] => collect { m with scalars := m.scalars ++ [(id, lo)] } none rest
    | none, 43, [_, id, lo, hi] =>
      collect { m with scalars := m.scalars ++ [(id, lo + 4294967296 * hi)] } none rest
    | none, 44, _ :: id :: items =>
      match lookAll m.scalars items with
      | some ns => collect { m with composites := m.composites ++ [(id, ns)] } none rest
      | none => none
    | none, 59, [_, id, sc] => collect { m with globals := m.globals ++ [(id, sc)] } none rest
    | none, 71, [id, 11, kind] => collect { m with builtins := m.builtins ++ [(id, kind)] } none rest
    | none, _, _ => collect m none rest
    | some f, 55, [_, p] =>
      match f.blocks with
      | [] => collect m (some { f with params := f.params ++ [p] }) rest
      | _ :: _ => none
    | some f, 248, [l] => collect m (some { f with blocks := (l, []) :: f.blocks }) rest
    | some f, 56, [] => collect { m with functions := closeFn f :: m.functions } none rest
    | some f, _, _ =>
      match f.blocks with
      | (l, is) :: bs => collect m (some { f with blocks := (l, i :: is) :: bs }) rest
      | [] => none

/-- Project a SPIR-V 1.5 word image. Module-scope instructions other than the ones listed in
    `Image` (names, member decorations, the remaining types) are dropped; every instruction inside
    a function body is kept. -/
def decode (words : Array UInt32) : Option Image :=
  match words.toList with
  | magic :: version :: _generator :: _bound :: schema :: rest =>
    if magic = 0x07230203 ∧ version = 0x10500 ∧ schema = 0 then
      match scan rest.length rest with
      | some insts => collect {} none insts
      | none => none
    else none
  | _ => none

