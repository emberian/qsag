            for (uint j = 0u; j < 44u; ++j) {
                u64vec4 exp_j = (j == 7u)  ? d_rem0
                              : (j == 8u)  ? d_rem1
                              : (j == 9u)  ? d_rem2
                              : (j == 10u) ? d_rem3
                              : (j == 11u) ? d_rem4
                              : (j == 42u) ? acc_next
                                           : prev_at(j, idx, half_m, k_val);
                emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), exp_j));
            }
            break;
        }
        case 16u: { // WotsTellInit
            u64vec4 layer_kp = fp4_add(step_c0, prev_at(4u, idx, half_m, k_val));
            for (uint i = 0u; i < 4u; ++i) {
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), signer_field_at(1u + i, idx, k_val)));
            }
            emit_term(acc, g, fp4_sub(st_in_at(4u, idx, half_m, k_val), layer_kp));
            emit_term(acc, g, fp4_sub(st_in_at(5u, idx, half_m, k_val), prev_at(5u, idx, half_m, k_val)));
            emit_term(acc, g, fp4_sub(st_in_at(6u, idx, half_m, k_val), prev_at(6u, idx, half_m, k_val)));
            emit_term(acc, g, f_sub_const(st_in_at(7u, idx, half_m, k_val), 128ul));
            emit_term(acc, g, f_sub_const(st_in_at(8u, idx, half_m, k_val), DOMAIN_WOTS_PK));
            emit_term(acc, g, st_in_at(9u, idx, half_m, k_val));
            emit_term(acc, g, st_in_at(10u, idx, half_m, k_val));
            emit_term(acc, g, f_sub_const(st_in_at(11u, idx, half_m, k_val), POSEIDON2_CONST_IV));
            for (uint i = 0u; i < 12u; ++i) {
                emit_term(acc, g, fp4_sub(next_at(13u + i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
            }
            for (uint j = 0u; j < 44u; ++j) {
                if (j < 13u || j >= 25u) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        case 17u: { // WotsChainStep0 { pack_slot = kind_arg }
            uint slot = kind_arg;
            u64vec4 u0 = aux_at(4u, idx, half_m, k_val);
            u64vec4 u1 = aux_at(5u, idx, half_m, k_val);
            u64vec4 u2 = aux_at(6u, idx, half_m, k_val);
            u64vec4 quot = aux_at(7u, idx, half_m, k_val);
            emit_term(acc, g, f_bool_check(u0));
            emit_term(acc, g, f_bool_check(u1));
            emit_term(acc, g, f_bool_check(u2));
            emit_term(acc, g, f_mul(u1, f_one_minus(u0)));
            emit_term(acc, g, f_mul(u2, f_one_minus(u1)));

            u64vec4 rem_r = fp4_sub(f_const(3ul), fp4_add(u0, fp4_add(u1, u2)));
            emit_term(acc, g, fp4_sub(prev_at(7u + slot, idx, half_m, k_val), fp4_add(rem_r, fp4_mul_base(quot, 4ul))));
            emit_term(acc, g, fp4_sub(next_at(7u + slot, idx, half_m, k_val), quot));

            u64vec4 addr_limb = fp4_add(step_c0, fp4_mul_base(prev_at(4u, idx, half_m, k_val), 1ul << 16u));
            u64vec4 omu0 = f_one_minus(u0);
            for (uint i = 0u; i < 4u; ++i) {
                u64vec4 sig_i = aux_at(i, idx, half_m, k_val);
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), sig_i));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), signer_field_at(1u + i, idx, k_val)));
                u64vec4 ff_i = fp4_add(perm_at(i, idx, half_m, k_slot), sig_i);
                emit_term(acc, g, fp4_sub(next_at(37u + i, idx, half_m, k_val), fp4_add(f_mul(u0, sig_i), f_mul(omu0, ff_i))));
            }
            emit_term(acc, g, f_sub_const(st_in_at(8u, idx, half_m, k_val), DOMAIN_WOTS_STEP));
            emit_term(acc, g, fp4_sub(st_in_at(9u, idx, half_m, k_val), addr_limb));
            emit_term(acc, g, fp4_sub(st_in_at(10u, idx, half_m, k_val), prev_at(5u, idx, half_m, k_val)));
            emit_term(acc, g, fp4_sub(st_in_at(11u, idx, half_m, k_val), prev_at(6u, idx, half_m, k_val)));
            emit_term(acc, g, fp4_sub(next_at(42u, idx, half_m, k_val), u1));
            emit_term(acc, g, fp4_sub(next_at(43u, idx, half_m, k_val), u2));
            for (uint j = 0u; j < 44u; ++j) {
                if (j != (7u + slot) && (j < 37u || j >= 41u) && j != 42u && j != 43u) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        case 18u: { // WotsChainStep1
            u64vec4 u1 = prev_at(42u, idx, half_m, k_val);
            u64vec4 omu1 = f_one_minus(u1);
            u64vec4 addr_limb = fp4_add(step_c0, fp4_mul_base(prev_at(4u, idx, half_m, k_val), 1ul << 16u));
            for (uint i = 0u; i < 4u; ++i) {
                u64vec4 cur_i = prev_at(37u + i, idx, half_m, k_val);
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), cur_i));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), signer_field_at(1u + i, idx, k_val)));
                u64vec4 ff_i = fp4_add(perm_at(i, idx, half_m, k_slot), cur_i);
                emit_term(acc, g, fp4_sub(next_at(37u + i, idx, half_m, k_val), fp4_add(f_mul(u1, cur_i), f_mul(omu1, ff_i))));
            }
            emit_term(acc, g, f_sub_const(st_in_at(8u, idx, half_m, k_val), DOMAIN_WOTS_STEP));
            emit_term(acc, g, fp4_sub(st_in_at(9u, idx, half_m, k_val), addr_limb));
            emit_term(acc, g, fp4_sub(st_in_at(10u, idx, half_m, k_val), prev_at(5u, idx, half_m, k_val)));
            emit_term(acc, g, fp4_sub(st_in_at(11u, idx, half_m, k_val), prev_at(6u, idx, half_m, k_val)));
            for (uint j = 0u; j < 44u; ++j) {
                if (j < 37u || j >= 41u) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        case 19u: { // WotsChainStep2 { is_odd = kind_arg }
            bool is_odd = (kind_arg != 0u);
            u64vec4 u2 = prev_at(43u, idx, half_m, k_val);
            u64vec4 omu2 = f_one_minus(u2);
            u64vec4 addr_limb = fp4_add(step_c0, fp4_mul_base(prev_at(4u, idx, half_m, k_val), 1ul << 16u));
            for (uint i = 0u; i < 4u; ++i) {
                u64vec4 cur_i = prev_at(37u + i, idx, half_m, k_val);
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), cur_i));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), signer_field_at(1u + i, idx, k_val)));
                u64vec4 ff_i = fp4_add(perm_at(i, idx, half_m, k_slot), cur_i);
                u64vec4 ep_i = fp4_add(f_mul(u2, cur_i), f_mul(omu2, ff_i));
                uint dst_s = is_odd ? (37u + i) : (25u + i);
                emit_term(acc, g, fp4_sub(next_at(dst_s, idx, half_m, k_val), ep_i));
            }
            emit_term(acc, g, f_sub_const(st_in_at(8u, idx, half_m, k_val), DOMAIN_WOTS_STEP));
            emit_term(acc, g, fp4_sub(st_in_at(9u, idx, half_m, k_val), addr_limb));
            emit_term(acc, g, fp4_sub(st_in_at(10u, idx, half_m, k_val), prev_at(5u, idx, half_m, k_val)));
            emit_term(acc, g, fp4_sub(st_in_at(11u, idx, half_m, k_val), prev_at(6u, idx, half_m, k_val)));
            for (uint j = 0u; j < 44u; ++j) {
                bool changed = is_odd ? (j >= 37u && j < 41u) : (j >= 25u && j < 29u);
                if (!changed) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        case 20u: { // WotsTellPairAbsorb { is_last_pair = kind_arg }
            if (kind_arg != 0u) {
                for (uint s = 0u; s < 5u; ++s) {
                    emit_term(acc, g, prev_at(7u + s, idx, half_m, k_val));
                }
            }
            for (uint i = 0u; i < 4u; ++i) {
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), fp4_add(prev_at(13u + i, idx, half_m, k_val), prev_at(25u + i, idx, half_m, k_val))));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), fp4_add(prev_at(17u + i, idx, half_m, k_val), prev_at(37u + i, idx, half_m, k_val))));
                emit_term(acc, g, fp4_sub(st_in_at(8u + i, idx, half_m, k_val), prev_at(21u + i, idx, half_m, k_val)));
            }
            for (uint i = 0u; i < 12u; ++i) {
                emit_term(acc, g, fp4_sub(next_at(13u + i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
            }
            for (uint j = 0u; j < 44u; ++j) {
                if (j < 13u || j >= 25u) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        case 21u: { // WotsTellFinalSqueeze
            emit_term(acc, g, fp4_sub(st_in_at(0u, idx, half_m, k_val), f_add_const(prev_at(13u, idx, half_m, k_val), 1ul)));
            for (uint i = 1u; i < 12u; ++i) {
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), prev_at(13u + i, idx, half_m, k_val)));
            }
            for (uint i = 0u; i < 4u; ++i) {
                emit_term(acc, g, fp4_sub(next_at(37u + i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
            }
            emit_term(acc, g, fp4_sub(next_at(41u, idx, half_m, k_val), prev_at(4u, idx, half_m, k_val)));
            for (uint j = 0u; j < 44u; ++j) {
                if (j < 37u || j > 41u) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        case 22u: { // XmssMerkleBlockA
            u64vec4 bit = aux_at(0u, idx, half_m, k_val);
            u64vec4 par = aux_at(1u, idx, half_m, k_val);
            emit_term(acc, g, f_bool_check(bit));
            emit_term(acc, g, fp4_sub(prev_at(41u, idx, half_m, k_val), fp4_add(bit, fp4_add(par, par))));
            u64vec4 omb = f_one_minus(bit);
            for (uint i = 0u; i < 4u; ++i) {
                u64vec4 ni = prev_at(37u + i, idx, half_m, k_val);
                u64vec4 si = aux_at(2u + i, idx, half_m, k_val);
                u64vec4 li = fp4_add(f_mul(omb, ni), f_mul(bit, si));
                u64vec4 ri = fp4_add(f_mul(bit, ni), f_mul(omb, si));
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), signer_field_at(1u + i, idx, k_val)));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), li));
                emit_term(acc, g, fp4_sub(next_at(37u + i, idx, half_m, k_val), ri));
            }
            u64vec4 meta0 = fp4_add(step_c0, par);
            emit_term(acc, g, f_sub_const(st_in_at(8u, idx, half_m, k_val), DOMAIN_MERKLE_NODE));
            emit_term(acc, g, fp4_sub(st_in_at(9u, idx, half_m, k_val), meta0));
            emit_term(acc, g, fp4_sub(st_in_at(10u, idx, half_m, k_val), prev_at(5u, idx, half_m, k_val)));
            emit_term(acc, g, fp4_sub(st_in_at(11u, idx, half_m, k_val), prev_at(6u, idx, half_m, k_val)));
            for (uint i = 0u; i < 12u; ++i) {
                emit_term(acc, g, fp4_sub(next_at(25u + i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
            }
            emit_term(acc, g, fp4_sub(next_at(41u, idx, half_m, k_val), par));
            for (uint j = 0u; j < 44u; ++j) {
                if (j < 25u || j > 41u) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
        default: { // 23u: XmssMerkleBlockB { is_layer_last = bit 0, is_top_final = bit 1 }
            bool is_layer_last = (kind_arg & 1u) != 0u;
            bool is_top_final  = (kind_arg & 2u) != 0u;
            for (uint i = 0u; i < 4u; ++i) {
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), fp4_add(prev_at(25u + i, idx, half_m, k_val), prev_at(37u + i, idx, half_m, k_val))));
            }
            emit_term(acc, g, fp4_sub(st_in_at(4u, idx, half_m, k_val), f_add_const(prev_at(29u, idx, half_m, k_val), 1ul)));
            emit_term(acc, g, fp4_sub(st_in_at(5u, idx, half_m, k_val), f_add_const(prev_at(30u, idx, half_m, k_val), POSEIDON2_CONST_IV)));
            for (uint i = 6u; i < 12u; ++i) {
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), prev_at(25u + i, idx, half_m, k_val)));
            }
            if (!is_layer_last) {
                for (uint i = 0u; i < 4u; ++i) {
                    emit_term(acc, g, fp4_sub(next_at(37u + i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
                }
                for (uint j = 0u; j < 44u; ++j) {
                    if (j < 37u || j >= 41u) {
                        emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                    }
                }
            } else if (is_top_final) {
                emit_term(acc, g, prev_at(41u, idx, half_m, k_val));
                for (uint i = 0u; i < 4u; ++i) {
                    emit_term(acc, g, fp4_sub(perm_at(i, idx, half_m, k_slot), signer_field_at(5u + i, idx, k_val)));
                }
                for (uint j = 0u; j < 44u; ++j) {
                    emit_term(acc, g, next_at(j, idx, half_m, k_val));
                }
            } else {
                emit_term(acc, g, prev_at(41u, idx, half_m, k_val));
                u64vec4 next_kp = u64vec4(0ul);
                for (uint i = 0u; i < 4u; ++i) {
                    u64vec4 ai = aux_at(i, idx, half_m, k_val);
                    emit_term(acc, g, f_bool_check(ai));
                    next_kp = fp4_add(next_kp, fp4_mul_base(ai, 1ul << i));
                }
                u64vec4 lo_sh = u64vec4(0ul);
                for (uint i = 0u; i < 14u; ++i) {
                    u64vec4 ai = aux_at(4u + i, idx, half_m, k_val);
                    emit_term(acc, g, f_quartic_base4(ai));
                    lo_sh = fp4_add(lo_sh, fp4_mul_base(ai, 1ul << (2u * i)));
                }
                u64vec4 hi_nib = u64vec4(0ul);
                for (uint i = 0u; i < 2u; ++i) {
                    u64vec4 ai = aux_at(18u + i, idx, half_m, k_val);
                    emit_term(acc, g, f_quartic_base4(ai));
                    hi_nib = fp4_add(hi_nib, fp4_mul_base(ai, 1ul << (2u * i)));
                }
                u64vec4 next_thi = u64vec4(0ul);
                for (uint i = 0u; i < 14u; ++i) {
                    u64vec4 ai = aux_at(20u + i, idx, half_m, k_val);
                    emit_term(acc, g, f_quartic_base4(ai));
                    next_thi = fp4_add(next_thi, fp4_mul_base(ai, 1ul << (2u * i)));
                }
                emit_term(acc, g, fp4_sub(prev_at(5u, idx, half_m, k_val), fp4_add(next_kp, fp4_mul_base(lo_sh, 16ul))));
                emit_term(acc, g, fp4_sub(prev_at(6u, idx, half_m, k_val), fp4_add(hi_nib, fp4_mul_base(next_thi, 16ul))));
                for (uint i = 0u; i < 4u; ++i) {
                    emit_term(acc, g, fp4_sub(next_at(i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
                }
                emit_term(acc, g, fp4_sub(next_at(4u, idx, half_m, k_val), next_kp));
                emit_term(acc, g, fp4_sub(next_at(5u, idx, half_m, k_val), fp4_add(lo_sh, fp4_mul_base(hi_nib, 1ul << 28u))));
                emit_term(acc, g, fp4_sub(next_at(6u, idx, half_m, k_val), next_thi));
                for (uint j = 7u; j < 44u; ++j) {
                    emit_term(acc, g, fp4_sub(next_at(j, idx, half_m, k_val), prev_at(j, idx, half_m, k_val)));
                }
            }
            break;
        }
    }
    return acc;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;
    uint half_m = pc.cur_m >> 1u;
    uint tid = pc.base_x + gl_GlobalInvocationID.x;

    uint k_slot = (pc.is_base != 0u) ? (wg_y + 1u) : wg_y;
    uint k_val = (k_slot == 0u) ? 0u : (k_slot + 1u);
    bool folding_signer = (pc.flags & 1u) != 0u;

    u64vec4 row_total = u64vec4(0ul);
    if (tid < half_m && k_slot < 8u) {
        uint idx = uint(b3.words[pc.sorted_u64_off + tid]);
        u64vec4 act_k = signer_field_at(0u, idx, k_val);

        if (!f_is_zero(act_k)) {
            u64vec4 sc0_k;
            uint op_key;
            if (folding_signer) {
                uint loc = idx & (pc.cur_r - 1u);
                sc0_k = load4_b3(pc.steps_off + loc * 3u + 2u);
                op_key = loc;
            } else {
                uint half_r = pc.cur_r >> 1u;
                u64vec4 sc0_0 = load4_b3(pc.steps_off + idx * 3u + 2u);
                u64vec4 sc0_1 = load4_b3(pc.steps_off + (idx + half_r) * 3u + 2u);
                sc0_k = interp_f(sc0_0, sc0_1, k_val);
                op_key = idx;
            }

            u64vec4 hdr = load4_b3(pc.op_hdr_off + op_key);
            uint e_start = uint(hdr.x);
            uint e_count = uint(hdr.y);

            u64vec4 eq_acc = u64vec4(0ul);
            for (uint e = 0u; e < e_count; ++e) {
                uint eo = pc.op_ent_off + (e_start + e) * 3u;
                u64vec4 meta = load4_b3(eo);
                u64vec4 v0   = load4_b3(eo + 1u);
                u64vec4 dv   = load4_b3(eo + 2u);
                u64vec4 raw_sel = (k_val == 0u) ? v0 : fp4_add(v0, fp4_mul_base(dv, uint64_t(k_val)));
                u64vec4 sel = f_mul(act_k, raw_sel);
                if (f_is_zero(sel)) {
                    continue;
                }
                u64vec4 op_acc = eval_single_op(
                    uint(meta.x),
                    uint(meta.y),
                    uint(meta.z),
                    sc0_k,
                    idx,
                    half_m,
                    k_slot,
                    k_val
                );
                if (pc.is_base != 0u) {
                    eq_acc = fp4_add(eq_acc, u64vec4(
                        fp_mul(op_acc.x, sel.x), fp_mul(op_acc.y, sel.x),
                        fp_mul(op_acc.z, sel.x), fp_mul(op_acc.w, sel.x)
                    ));
                } else {
                    eq_acc = fp4_add(eq_acc, fp4_mul_full(sel, op_acc));
                }
            }

            if (!(eq_acc.x == 0ul && eq_acc.y == 0ul && eq_acc.z == 0ul && eq_acc.w == 0ul)) {
                uint sh_base = pc.sh_src;
                u64vec4 eq0 = load4_b2(sh_base + idx);
                u64vec4 eq1 = load4_b2(sh_base + idx + half_m);
                u64vec4 cur_eq = interp_ext4_full(eq0, eq1, k_val);
                row_total = fp4_mul_full(cur_eq, eq_acc);
            }
        }
    }

    red_store(lid, row_total);
    barrier();
    for (uint s = 32u; s >= 1u; s >>= 1u) {
        if (lid < s) {
            red_store(lid, fp4_add(red_load(lid), red_load(lid + s)));
        }
        barrier();
    }

    if (lid == 0u && k_slot < 8u) {
        uint o_idx = pc.out_off + k_slot * gl_NumWorkGroups.x + wg_x;
        store4_b5(o_idx, fp4_add(load4_b5(o_idx), red_load(0u)));
    }
}
