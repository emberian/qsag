                u64vec4 next_tlo = fp4_add(tmp_load(lid, 1u), fp4_mul_base(tmp_load(lid, 2u), 1ul << 28u));
                [[dont_unroll]] for (uint i = 0u; i < 3u; ++i) {
                    u64vec4 exp_n = (i == 0u) ? tmp_load(lid, 0u) : (i == 1u) ? next_tlo : tmp_load(lid, 3u);
                    emit_term(acc, g, fp4_sub(next_at(4u + i, idx, half_m, k_val), exp_n));
                }
                carry_mask = ALL44 & ~0x7Ful;
            }
            break;
        }
    }

    if (perm_len > 0u) {
        [[dont_unroll]] for (uint i = 0u; i < perm_len; ++i) {
            emit_term(acc, g, fp4_sub(next_at(perm_dst + i, idx, half_m, k_val), perm_at(i, idx, half_m, k_slot)));
        }
    }
    if (zero_mid > 0u) {
        [[dont_unroll]] for (uint s = 0u; s < 6u; ++s) {
            emit_term(acc, g, next_at(7u + s, idx, half_m, k_val));
        }
        if (zero_mid == 2u) {
            emit_term(acc, g, next_at(42u, idx, half_m, k_val));
        }
    }
    if (has_post_41) {
        emit_term(acc, g, fp4_sub(next_at(41u, idx, half_m, k_val), tmp_load(lid, 0u)));
    }
    uint64_t tail_mask = zero_mask | carry_mask;
    if (tail_mask != 0ul) {
        [[dont_unroll]] for (uint j = 0u; j < 44u; ++j) {
            uint64_t bit = 1ul << j;
            if ((tail_mask & bit) != 0ul) {
                u64vec4 expr = next_at(j, idx, half_m, k_val);
                if ((carry_mask & bit) != 0ul) {
                    expr = fp4_sub(expr, prev_at(j, idx, half_m, k_val));
                }
                emit_term(acc, g, expr);
            }
        }
    }
    return acc;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;
    uint half_m = pc.cur_m >> 1u;
    uint tid = pc.base_x + gl_GlobalInvocationID.x;

    uint k_slot = (pc.is_base != 0u) ? (wg_y + 1u) : wg_y;
    uint k_val = (k_slot == 0u) ? 0u : (k_slot + 1u);
    bool folding_signer = (pc.flags & 1u) != 0u;

    u64vec4 row_total = u64vec4(0ul);
    if (tid < half_m && k_slot < 8u) {
        uint idx = uint(b3.words[pc.sorted_u64_off + tid]);
        u64vec4 act_k = signer_field_at(0u, idx, k_val);

        if (!f_is_zero(act_k)) {
            tmp_store(lid, 7u, act_k);
            uint op_key;
            if (folding_signer) {
                uint loc = idx & (pc.cur_r - 1u);
                tmp_store(lid, 8u, load4_b3(pc.steps_off + loc * 3u + 2u));
                op_key = loc;
            } else {
                uint half_r = pc.cur_r >> 1u;
                u64vec4 sc0_0 = load4_b3(pc.steps_off + idx * 3u + 2u);
                u64vec4 sc0_1 = load4_b3(pc.steps_off + (idx + half_r) * 3u + 2u);
                tmp_store(lid, 8u, interp_f(sc0_0, sc0_1, k_val));
                op_key = idx;
            }

            u64vec4 hdr = load4_b3(pc.op_hdr_off + op_key);
            uint e_start = uint(hdr.x);
            uint e_count = uint(hdr.y);

            tmp_store(lid, 9u, u64vec4(0ul));
            [[dont_unroll]] for (uint e = 0u; e < e_count; ++e) {
                uint eo = pc.op_ent_off + (e_start + e) * 3u;
                u64vec4 meta = load4_b3(eo);
                u64vec4 raw_sel = fp4_add(load4_b3(eo + 1u), fp4_mul_k(load4_b3(eo + 2u), k_val));
                u64vec4 sel = fp4_mul_full(tmp_load(lid, 7u), raw_sel);
                if (!f_is_zero(sel)) {
                    tmp_store(lid, 6u, sel);
                    u64vec4 op_acc = eval_single_op(
                        lid,
                        uint(meta.x),
                        uint(meta.y),
                        uint(meta.z),
                        idx,
                        half_m,
                        k_slot,
                        k_val
                    );
                    tmp_store(lid, 9u, fp4_add(tmp_load(lid, 9u), fp4_mul_full(tmp_load(lid, 6u), op_acc)));
                }
            }

            u64vec4 eq_acc = tmp_load(lid, 9u);
            if (!f_is_zero(eq_acc)) {
                uint sh_base = pc.sh_src;
                u64vec4 eq0 = load4_b2(sh_base + idx);
                u64vec4 eq1 = load4_b2(sh_base + idx + half_m);
                u64vec4 cur_eq = interp_f(eq0, eq1, k_val);
                row_total = fp4_mul_full(cur_eq, eq_acc);
            }
        }
    }

    red_store(lid, row_total);
    barrier();
    [[dont_unroll]] for (uint s = 32u; s >= 1u; s >>= 1u) {
        if (lid < s) {
            red_store(lid, fp4_add(red_load(lid), red_load(lid + s)));
        }
        barrier();
    }

    if (lid == 0u && k_slot < 8u) {
        uint o_idx = pc.out_off + k_slot * gl_NumWorkGroups.x + wg_x;
        store4_b5(o_idx, fp4_add(load4_b5(o_idx), red_load(0u)));
    }
}
