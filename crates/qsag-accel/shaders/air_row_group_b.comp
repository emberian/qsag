#version 460
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_control_flow_attributes : require

// Certified SPIR-V 1.5 compute kernel for `ProverKernelSlot::AirRowGroupB`.
// VRAM-resident sparse Group-B 24-opcode AIR row-constraint evaluator for both Round-0 base-field
// (`is_base == 1`, `k_val in 2..=8`) and Rounds >= 1 `Ext4` (`is_base == 0`, `k_val in {0, 2..=8}`),
// sorted by `op_uid` so Wave32 lanes execute uniform opcode branches with zero register spills.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Buf0 { uint64_t words[]; } b0; // cols_base
layout(std430, set = 0, binding = 1) buffer Buf1 { uint64_t words[]; } b1; // cols_ext4
layout(std430, set = 0, binding = 2) buffer Buf2 { uint64_t words[]; } b2; // shift_tables (`eq_tau`)
layout(std430, set = 0, binding = 3) buffer Buf3 { uint64_t words[]; } b3; // sched + pub + op_pairs + sorted_idx
layout(std430, set = 0, binding = 4) buffer Buf4 { uint64_t words[]; } b4; // vram_perm
layout(std430, set = 0, binding = 5) buffer Buf5 { uint64_t words[]; } b5; // partials (accumulated onto Group A)

layout(push_constant) uniform PushConsts {
    uint is_base;        // 1 for Round 0 (`wg_y in 0..7 -> k_slot = wg_y + 1`), 0 for Rounds >= 1 (`wg_y in 0..8`)
    uint cur_m;          // total rows (`half_m = cur_m / 2`)
    uint cur_r;          // local step rows per signer
    uint cur_s;          // signer slots (`half_s = cur_s / 2`)
    uint flags;          // bit 0: folding_signer
    uint col_src;        // `u64` offset in `b0` (Round 0) or `Ext4` offset in `b1` (Rounds >= 1)
    uint sh_src;         // `Ext4` offset in `b2`
    uint signers_off;    // `Ext4` offset in `b3` (`14` `Ext4`s/signer: act, pks[4], pkr[4], mu[5])
    uint steps_off;      // `Ext4` offset in `b3` (`3` `Ext4`s/step: rf, rl, sc0)
    uint op_hdr_off;     // `Ext4` offset in `b3` (`[start, count, 0, 0]`)
    uint op_ent_off;     // `Ext4` offset in `b3` (`3` `Ext4`s/entry: `[meta, v0, dv]`)
    uint sorted_u64_off; // `u64` offset in `b3` of `sorted_idx[0..half_m]`
    uint out_off;        // `Ext4` offset in `b5`
    uint base_x;
    uint _pad0;
    uint _pad1;
} pc;

const uint64_t GL_P   = 0xFFFFFFFF00000001ul;
const uint64_t GL_EPS = 0xFFFFFFFFul;

const uint64_t POSEIDON2_CONST_IV      = 0x504F53325F474C31ul;
const uint64_t DOMAIN_WOTS_STEP        = 0x5153414757535450ul;
const uint64_t DOMAIN_WOTS_PK          = 0x5153414757504B31ul;
const uint64_t DOMAIN_MERKLE_NODE      = 0x515341474D524B4Cul;
const uint64_t DOMAIN_H_MSG_STATEFUL   = 0x51534147484D5331ul;
const uint64_t DOMAIN_H_MSG_DET_TREE   = 0x5153414748445452ul;
const uint64_t DOMAIN_H_MSG_STATELESS  = 0x515341474853544Cul;
const uint64_t DOMAIN_FORS_LEAF        = 0x51534147464C4546ul;
const uint64_t DOMAIN_FORS_NODE        = 0x51534147464E4F44ul;
const uint64_t DOMAIN_FORS_ROOTS       = 0x5153414746525453ul;

const uint64_t ALL44      = (1ul << 44u) - 1ul;
const uint64_t MASK_13_25 = ((1ul << 12u) - 1ul) << 13u;
const uint64_t MASK_7_25  = ((1ul << 18u) - 1ul) << 7u;

shared uint s_red[8][64];
shared uint s_tmp[80][64];

u64vec4 tmp_load(uint lid, uint slot) {
    uint b = slot * 8u;
    return u64vec4(
        uint64_t(s_tmp[b + 0u][lid]) | (uint64_t(s_tmp[b + 1u][lid]) << 32u),
        uint64_t(s_tmp[b + 2u][lid]) | (uint64_t(s_tmp[b + 3u][lid]) << 32u),
        uint64_t(s_tmp[b + 4u][lid]) | (uint64_t(s_tmp[b + 5u][lid]) << 32u),
        uint64_t(s_tmp[b + 6u][lid]) | (uint64_t(s_tmp[b + 7u][lid]) << 32u)
    );
}

void tmp_store(uint lid, uint slot, u64vec4 v) {
    uint b = slot * 8u;
    s_tmp[b + 0u][lid] = uint(v.x); s_tmp[b + 1u][lid] = uint(v.x >> 32u);
    s_tmp[b + 2u][lid] = uint(v.y); s_tmp[b + 3u][lid] = uint(v.y >> 32u);
    s_tmp[b + 4u][lid] = uint(v.z); s_tmp[b + 5u][lid] = uint(v.z >> 32u);
    s_tmp[b + 6u][lid] = uint(v.w); s_tmp[b + 7u][lid] = uint(v.w >> 32u);
}

u64vec4 red_load(uint i) {
    return u64vec4(
        uint64_t(s_red[0][i]) | (uint64_t(s_red[1][i]) << 32u),
        uint64_t(s_red[2][i]) | (uint64_t(s_red[3][i]) << 32u),
        uint64_t(s_red[4][i]) | (uint64_t(s_red[5][i]) << 32u),
        uint64_t(s_red[6][i]) | (uint64_t(s_red[7][i]) << 32u)
    );
}

void red_store(uint i, u64vec4 v) {
    s_red[0][i] = uint(v.x); s_red[1][i] = uint(v.x >> 32u);
    s_red[2][i] = uint(v.y); s_red[3][i] = uint(v.y >> 32u);
    s_red[4][i] = uint(v.z); s_red[5][i] = uint(v.z >> 32u);
    s_red[6][i] = uint(v.w); s_red[7][i] = uint(v.w >> 32u);
}

uint64_t fp_reduce_u64(uint64_t x) {
    return x - (GL_P & (0ul - uint64_t(x >= GL_P)));
}

uint64_t fp_add(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t rem_p = GL_P - b_c;
    uint64_t mask = 0ul - uint64_t(a_c < rem_p);
    return ((a_c + b_c) & mask) | ((a_c - rem_p) & ~mask);
}

uint64_t fp_sub(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t diff = a_c - b_c;
    return diff + (GL_P & (0ul - uint64_t(a_c < b_c)));
}

uint64_t fp_reduce128(uint64_t lo, uint64_t hi) {
    uint64_t hi_lo = hi & GL_EPS;
    uint64_t hi_hi = hi >> 32u;
    uint64_t mid = (hi_lo << 32u) - hi_lo;
    uint64_t lo_c = fp_reduce_u64(lo);
    return fp_sub(fp_add(lo_c, mid), hi_hi);
}

uint64_t fp_mul_k(uint64_t d, uint k) {
    uint64_t d_c = fp_reduce_u64(d);
    uint64_t lo = (d_c & 0xFFFFFFFFul) * uint64_t(k);
    uint64_t hi = (d_c >> 32u) * uint64_t(k) + (lo >> 32u);
    return fp_reduce128((lo & 0xFFFFFFFFul) | (hi << 32u), hi >> 32u);
}

uint64_t fp_mul(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t a_lo = a_c & 0xFFFFFFFFul;
    uint64_t a_hi = a_c >> 32u;
    uint64_t b_lo = b_c & 0xFFFFFFFFul;
    uint64_t b_hi = b_c >> 32u;
    uint64_t p0 = a_lo * b_lo;
    uint64_t p1 = a_lo * b_hi;
    uint64_t p2 = a_hi * b_lo;
    uint64_t p3 = a_hi * b_hi;
    uint64_t mid = (p0 >> 32u) + (p1 & 0xFFFFFFFFul) + (p2 & 0xFFFFFFFFul);
    uint64_t lo = (p0 & 0xFFFFFFFFul) | (mid << 32u);
    uint64_t hi = p3 + (p1 >> 32u) + (p2 >> 32u) + (mid >> 32u);
    return fp_reduce128(lo, hi);
}

u64vec2 fp2_add(u64vec2 a, u64vec2 b) { return u64vec2(fp_add(a.x, b.x), fp_add(a.y, b.y)); }
u64vec2 fp2_sub(u64vec2 a, u64vec2 b) { return u64vec2(fp_sub(a.x, b.x), fp_sub(a.y, b.y)); }
u64vec2 fp2_mul_by_u(u64vec2 a) { return u64vec2(fp_mul_k(a.y, 7u), a.x); }

u64vec2 fp2_mul(u64vec2 a, u64vec2 b) {
    uint64_t a0b0 = fp_mul(a.x, b.x);
    uint64_t a1b1 = fp_mul(a.y, b.y);
    uint64_t mid = fp_sub(fp_sub(fp_mul(fp_add(a.x, a.y), fp_add(b.x, b.y)), a0b0), a1b1);
    return u64vec2(fp_add(a0b0, fp_mul_k(a1b1, 7u)), mid);
}

u64vec4 fp4_add(u64vec4 a, u64vec4 b) {
    return u64vec4(fp_add(a.x, b.x), fp_add(a.y, b.y), fp_add(a.z, b.z), fp_add(a.w, b.w));
}

u64vec4 fp4_sub(u64vec4 a, u64vec4 b) {
    return u64vec4(fp_sub(a.x, b.x), fp_sub(a.y, b.y), fp_sub(a.z, b.z), fp_sub(a.w, b.w));
}

u64vec4 fp4_mul_base(u64vec4 a, uint64_t s) {
    return u64vec4(fp_mul(a.x, s), fp_mul(a.y, s), fp_mul(a.z, s), fp_mul(a.w, s));
}

u64vec4 fp4_mul_k(u64vec4 a, uint k) {
    return u64vec4(fp_mul_k(a.x, k), fp_mul_k(a.y, k), fp_mul_k(a.z, k), fp_mul_k(a.w, k));
}

u64vec4 fp4_mul_full(u64vec4 a, u64vec4 b) {
    u64vec2 v0 = fp2_mul(a.xy, b.xy);
    u64vec2 v1 = fp2_mul(a.zw, b.zw);
    u64vec2 mid = fp2_sub(fp2_sub(fp2_mul(fp2_add(a.xy, a.zw), fp2_add(b.xy, b.zw)), v0), v1);
    return u64vec4(fp2_add(v0, fp2_mul_by_u(v1)), mid);
}

u64vec4 fp4_sq(u64vec4 a) {
    u64vec2 p0 = fp2_mul(a.xy, a.zw);
    u64vec2 up0 = fp2_mul_by_u(p0);
    u64vec2 t = fp2_mul(fp2_add(a.xy, a.zw), fp2_add(a.xy, fp2_mul_by_u(a.zw)));
    return u64vec4(fp2_sub(fp2_sub(t, p0), up0), fp2_add(p0, p0));
}

u64vec4 f_const(uint64_t v) {
    return u64vec4(fp_reduce_u64(v), 0ul, 0ul, 0ul);
}

u64vec4 f_add_const(u64vec4 a, uint64_t v) {
    a.x = fp_add(a.x, fp_reduce_u64(v));
    return a;
}

u64vec4 f_sub_const(u64vec4 a, uint64_t v) {
    a.x = fp_sub(a.x, fp_reduce_u64(v));
    return a;
}

u64vec4 f_one_minus(u64vec4 a) {
    return fp4_sub(u64vec4(1ul, 0ul, 0ul, 0ul), a);
}

u64vec4 f_bool_check(u64vec4 b) {
    return fp4_sub(b, fp4_sq(b));
}

u64vec4 f_quartic_base4(u64vec4 d) {
    u64vec4 u = f_add_const(fp4_sub(fp4_sq(d), fp4_mul_k(d, 3u)), 1ul);
    return f_sub_const(fp4_sq(u), 1ul);
}

bool f_is_zero(u64vec4 a) {
    return (a.x == 0ul) && (a.y == 0ul) && (a.z == 0ul) && (a.w == 0ul);
}

u64vec4 load4_b1(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b1.words[o], b1.words[o + 1u], b1.words[o + 2u], b1.words[o + 3u]);
}

u64vec4 load4_b2(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b2.words[o], b2.words[o + 1u], b2.words[o + 2u], b2.words[o + 3u]);
}

u64vec4 load4_b3(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b3.words[o], b3.words[o + 1u], b3.words[o + 2u], b3.words[o + 3u]);
}

u64vec4 load4_b4(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b4.words[o], b4.words[o + 1u], b4.words[o + 2u], b4.words[o + 3u]);
}

u64vec4 load4_b5(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b5.words[o], b5.words[o + 1u], b5.words[o + 2u], b5.words[o + 3u]);
}

void store4_b5(uint idx, u64vec4 v) {
    uint o = idx * 4u;
    b5.words[o] = v.x; b5.words[o + 1u] = v.y; b5.words[o + 2u] = v.z; b5.words[o + 3u] = v.w;
}

u64vec4 interp_f(u64vec4 v0, u64vec4 v1, uint k_val) {
    return fp4_add(v0, fp4_mul_k(fp4_sub(v1, v0), k_val));
}

u64vec4 col_at(uint c, uint idx, uint half_m, uint k_val) {
    uint base = pc.col_src + c * pc.cur_m;
    uint step = (k_val == 0u) ? 0u : half_m;
    if (pc.is_base != 0u) {
        uint64_t r0 = fp_reduce_u64(b0.words[base + idx]);
        uint64_t r1 = fp_reduce_u64(b0.words[base + idx + step]);
        return u64vec4(fp_add(r0, fp_mul_k(fp_sub(r1, r0), k_val)), 0ul, 0ul, 0ul);
    }
    u64vec4 r0 = load4_b1(base + idx);
    u64vec4 r1 = load4_b1(base + idx + step);
    return fp4_add(r0, fp4_mul_k(fp4_sub(r1, r0), k_val));
}

u64vec4 st_in_at(uint i, uint idx, uint half_m, uint k_val) { return col_at(i, idx, half_m, k_val); }
u64vec4 prev_at(uint j, uint idx, uint half_m, uint k_val)  { return col_at(130u + j, idx, half_m, k_val); }
u64vec4 next_at(uint j, uint idx, uint half_m, uint k_val)  { return col_at(174u + j, idx, half_m, k_val); }
u64vec4 aux_at(uint i, uint idx, uint half_m, uint k_val)   { return col_at(218u + i, idx, half_m, k_val); }

u64vec4 perm_at(uint i, uint idx, uint half_m, uint k_slot) {
    if (pc.is_base != 0u) {
        uint off = ((k_slot - 1u) * half_m + idx) * 12u + i;
        return u64vec4(b4.words[off], 0ul, 0ul, 0ul);
    }
    uint off = (k_slot * half_m + idx) * 12u + i;
    return load4_b4(off);
}

// Weighted 2-to-1 compression output limb `i` (`0..4`) of a tweaked hash row:
// `perm_out[i] + in0[i] + 2 * st_in[4 + i] + 4 * st_in[8 + i]`, where `in0` is the value the
// row constrains `st_in[i]` to (FORS leaf preimage, WOTS chain value), `st_in[4..8]` is the
// second input (`pk_seed`) and `st_in[8..12]` is the domain/address tweak.
u64vec4 weighted_feed_forward(u64vec4 in0, uint i, uint idx, uint half_m, uint k_slot, uint k_val) {
    u64vec4 in1 = st_in_at(4u + i, idx, half_m, k_val);
    u64vec4 tweak = st_in_at(8u + i, idx, half_m, k_val);
    return fp4_add(
        fp4_add(perm_at(i, idx, half_m, k_slot), in0),
        fp4_add(fp4_mul_k(in1, 2u), fp4_mul_k(tweak, 4u))
    );
}

u64vec4 signer_field_at(uint field_idx, uint idx, uint k_val) {
    if ((pc.flags & 1u) != 0u) {
        uint half_s = pc.cur_s >> 1u;
        uint s0 = idx / pc.cur_r;
        uint s1 = s0 + half_s;
        u64vec4 v0 = load4_b3(pc.signers_off + s0 * 14u + field_idx);
        u64vec4 v1 = load4_b3(pc.signers_off + s1 * 14u + field_idx);
        return interp_f(v0, v1, k_val);
    }
    return load4_b3(pc.signers_off + field_idx);
}

void emit_term(inout u64vec4 op_acc, inout uint g_idx, u64vec4 expr) {
    op_acc = fp4_add(op_acc, fp4_mul_full(load4_b3(g_idx), expr));
    g_idx += 1u;
}

uint64_t shl_pow2(uint shift) {
    return (shift == 62u) ? (1ul << 62u) : (1ul << shift);
}

u64vec4 eval_single_op(
    uint lid,
    uint kind_id,
    uint kind_arg,
    uint gamma_base,
    uint idx,
    uint half_m,
    uint k_slot,
    uint k_val
) {
    u64vec4 acc = u64vec4(0ul);
    uint g = gamma_base;

    uint perm_len = 0u;
    uint perm_dst = 13u;
    uint zero_mid = 0u;
    bool has_post_41 = false;
    uint64_t zero_mask = 0ul;
    uint64_t carry_mask = 0ul;

    switch (kind_id) {
        case 0u: { // Idle
            zero_mask = ALL44;
            break;
        }
        case 1u: { // StatefulHmsgBlock0
            tmp_store(lid, 0u, u64vec4(0ul));
            tmp_store(lid, 1u, u64vec4(0ul));
            [[dont_unroll]] for (uint i = 0u; i < 38u; ++i) {
                u64vec4 ai = aux_at(i, idx, half_m, k_val);
                emit_term(acc, g, f_bool_check(ai));
                if (i < 6u) {
                    tmp_store(lid, 0u, fp4_add(tmp_load(lid, 0u), fp4_mul_base(ai, 1ul << i)));
                } else {
                    tmp_store(lid, 1u, fp4_add(tmp_load(lid, 1u), fp4_mul_base(ai, 1ul << (i - 6u))));
                }
            }
            [[dont_unroll]] for (uint i = 0u; i < 4u; ++i) {
                u64vec4 pks = signer_field_at(1u + i, idx, k_val);
                u64vec4 pkr = signer_field_at(5u + i, idx, k_val);
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), pks));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), pkr));
                emit_term(acc, g, fp4_sub(next_at(i, idx, half_m, k_val), pkr));
            }
            u64vec4 kp_ctr = fp4_add(fp4_mul_base(tmp_load(lid, 0u), 1ul << 32u), tmp_load(lid, 1u));
            [[dont_unroll]] for (uint i = 0u; i < 4u; ++i) {
                u64vec4 exp_in = (i == 0u) ? f_const(DOMAIN_H_MSG_STATEFUL)
                               : (i == 1u) ? kp_ctr
                               : (i == 2u) ? signer_field_at(13u, idx, k_val)
                                           : f_const(POSEIDON2_CONST_IV);
                emit_term(acc, g, fp4_sub(st_in_at(8u + i, idx, half_m, k_val), exp_in));
            }
            emit_term(acc, g, fp4_sub(next_at(4u, idx, half_m, k_val), tmp_load(lid, 0u)));
            perm_len = 12u;
            perm_dst = 13u;
            zero_mask = (ALL44 & ~0x1Ful) & ~MASK_13_25;
            break;
        }
        case 2u:   // StatefulHmsgBlock1
        case 5u:   // StatelessDeriveBlock1
        case 11u:  // ForsRootsPairAbsorb { is_last_pair = kind_arg }
        case 20u: { // WotsTellPairAbsorb { is_last_pair = kind_arg }
            uint rem_chk = (kind_id == 11u && kind_arg != 0u) ? 6u
                         : (kind_id == 20u && kind_arg != 0u) ? 5u
                                                              : 0u;
            [[dont_unroll]] for (uint s = 0u; s < rem_chk; ++s) {
                emit_term(acc, g, prev_at(7u + s, idx, half_m, k_val));
            }
            bool is_msg = (kind_id == 2u) || (kind_id == 5u);
            [[dont_unroll]] for (uint i = 0u; i < 4u; ++i) {
                u64vec4 lo_add = is_msg ? aux_at(i, idx, half_m, k_val)
                               : (kind_id == 11u) ? prev_at(i, idx, half_m, k_val)
                                                  : prev_at(25u + i, idx, half_m, k_val);
                u64vec4 hi_add = is_msg ? signer_field_at(9u + i, idx, k_val)
                                        : prev_at(37u + i, idx, half_m, k_val);
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), fp4_add(prev_at(13u + i, idx, half_m, k_val), lo_add)));
                emit_term(acc, g, fp4_sub(st_in_at(4u + i, idx, half_m, k_val), fp4_add(prev_at(17u + i, idx, half_m, k_val), hi_add)));
                emit_term(acc, g, fp4_sub(st_in_at(8u + i, idx, half_m, k_val), prev_at(21u + i, idx, half_m, k_val)));
            }
            perm_len = 12u;
            perm_dst = 13u;
            if (kind_id == 5u) {
                zero_mid = 1u;
                carry_mask = ALL44 & ~MASK_7_25;
            } else {
                carry_mask = ALL44 & ~MASK_13_25;
            }
            break;
        }
        case 3u:   // StatefulHmsgSqueeze
        case 12u:  // ForsRootsFinalSqueeze
        case 21u: { // WotsTellFinalSqueeze
            [[dont_unroll]] for (uint i = 0u; i < 12u; ++i) {
                u64vec4 exp_in = prev_at(13u + i, idx, half_m, k_val);
                if (i == 0u) {
                    exp_in = f_add_const(exp_in, 1ul);
                }
                emit_term(acc, g, fp4_sub(st_in_at(i, idx, half_m, k_val), exp_in));
            }
            if (kind_id == 3u) {
                perm_len = 12u;
                perm_dst = 13u;
                zero_mid = 2u;
                carry_mask = ALL44 & ~MASK_7_25 & ~(1ul << 42u);
            } else if (kind_id == 12u) {
                perm_len = 4u;
                perm_dst = 0u;
                carry_mask = ALL44 & ~0xFul;
            } else {
                perm_len = 4u;
                perm_dst = 37u;
                has_post_41 = true;
                tmp_store(lid, 0u, prev_at(4u, idx, half_m, k_val));
                carry_mask = ALL44 & ~(0x1Ful << 37u);
            }
            break;
        }
        case 4u:   // StatelessDeriveBlock0
        case 13u: { // DetTreeHmsgBlock0
