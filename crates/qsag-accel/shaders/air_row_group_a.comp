#version 460
#extension GL_ARB_gpu_shader_int64 : require

// Certified SPIR-V 1.5 compute kernel for `ProverKernelSlot::AirRowGroupA`.
// VRAM-resident witness transpose (`row-major -> col-major`), Round-0 base-field & Rounds >= 1
// `Ext4` Poseidon2 Group-A + boundary + degree-2 shift-bus evaluation (emitting `perm_out[0..12]`
// to `b4` for `AirRowGroupB`), and coalesced column/shift-table folding.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Buf0 { uint64_t words[]; } b0; // witness / cols_base
layout(std430, set = 0, binding = 1) buffer Buf1 { uint64_t words[]; } b1; // cols_ext4 ping-pong
layout(std430, set = 0, binding = 2) buffer Buf2 { uint64_t words[]; } b2; // shift_tables (eq_tau, nl, sh)
layout(std430, set = 0, binding = 3) buffer Buf3 { uint64_t words[]; } b3; // sched + pub tables
layout(std430, set = 0, binding = 4) buffer Buf4 { uint64_t words[]; } b4; // vram_perm
layout(std430, set = 0, binding = 5) buffer Buf5 { uint64_t words[]; } b5; // partials

layout(push_constant) uniform PushConsts {
    u64vec4 chal;
    uint    mode;       // 0=transpose, 1=eval_round0_base, 2=eval_ext4, 3=fold_round0, 4=fold_ext4, 5=fold_shifts
    uint    cur_m;      // total rows in current round (`half = cur_m / 2`)
    uint    cur_r;      // local step rows per signer in current round
    uint    flags;      // bit 0: folding_signer
    uint    col_src;    // `Ext4` base offset in `b1` (or `u64` witness offset in `b0`)
    uint    col_dst;    // `Ext4` dst offset in `b1` (or `u64` cols_base offset in `b0`)
    uint    sh_src;     // `Ext4` base offset in `b2` (`3 * cur_m` `Ext4`s)
    uint    steps_off;  // `Ext4` offset in `b3` of `step_pub[0..cur_r]` (`3` `Ext4`s/step: rf, rl, sc0)
    uint    out_off;    // `Ext4` offset in `b5` for partial sums (or `sh_dst` in mode 5)
    uint    base_x;
    uint    aux0;
    uint    aux1;
} pc;

