uint64_t fp_reduce_u64(uint64_t x) {
    return (x >= GL_P) ? (x - GL_P) : x;
}

uint64_t fp_add(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t rem_p = GL_P - b_c;
    return (a_c < rem_p) ? (a_c + b_c) : (a_c - rem_p);
}

uint64_t fp_sub(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t diff = a_c - b_c;
    return (a_c < b_c) ? (diff + GL_P) : diff;
}

uint64_t fp_neg(uint64_t a) {
    return fp_sub(0ul, a);
}

uint64_t fp_reduce128(uint64_t lo, uint64_t hi) {
    uint64_t hi_lo = hi & GL_EPS;
    uint64_t hi_hi = hi >> 32;
    uint64_t mid = (hi_lo << 32) - hi_lo;
    uint64_t lo_c = fp_reduce_u64(lo);
    return fp_sub(fp_add(lo_c, mid), hi_hi);
}

uint64_t fp_mul(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t a_lo = a_c & 0xFFFFFFFFul;
    uint64_t a_hi = a_c >> 32;
    uint64_t b_lo = b_c & 0xFFFFFFFFul;
    uint64_t b_hi = b_c >> 32;
    uint64_t p0 = a_lo * b_lo;
    uint64_t p1 = a_lo * b_hi;
    uint64_t p2 = a_hi * b_lo;
    uint64_t p3 = a_hi * b_hi;
    uint64_t mid = (p0 >> 32) + (p1 & 0xFFFFFFFFul) + (p2 & 0xFFFFFFFFul);
    uint64_t lo = (p0 & 0xFFFFFFFFul) | (mid << 32);
    uint64_t hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
    return fp_reduce128(lo, hi);
}

uint64_t fp_sq(uint64_t a) {
    return fp_mul(a, a);
}

// Exact `(x << k) mod GL_P` for canonical `x < GL_P` and `1 <= k <= 10`.
uint64_t fp_shl_canonical(uint64_t x, uint k) {
    return fp_reduce128(x << k, x >> (64u - k));
}

uint64_t poseidon2_sbox7(uint64_t x) {
    uint64_t x2 = fp_sq(x);
    uint64_t x3 = fp_mul(x2, x);
    uint64_t x4 = fp_sq(x2);
    return fp_mul(x3, x4);
}

void poseidon2_apply_m4(inout uint64_t b0, inout uint64_t b1, inout uint64_t b2, inout uint64_t b3) {
    uint64_t s = fp_add(fp_add(b0, b1), fp_add(b2, b3));
    uint64_t r0 = fp_add(s, fp_add(b0, fp_add(b1, b1)));
    uint64_t r1 = fp_add(s, fp_add(b1, fp_add(b2, b2)));
    uint64_t r2 = fp_add(s, fp_add(b2, fp_add(b3, b3)));
    uint64_t r3 = fp_add(s, fp_add(b3, fp_add(b0, b0)));
    b0 = r0;
    b1 = r1;
    b2 = r2;
    b3 = r3;
}

void poseidon2_apply_me(inout uint64_t st[12]) {
    for (uint i = 0u; i < 12u; ++i) {
        st[i] = fp_reduce_u64(st[i]);
    }
    poseidon2_apply_m4(st[0], st[1], st[2], st[3]);
    poseidon2_apply_m4(st[4], st[5], st[6], st[7]);
    poseidon2_apply_m4(st[8], st[9], st[10], st[11]);
    for (uint i = 0u; i < 4u; ++i) {
        uint64_t s = fp_add(fp_add(st[i], st[4u + i]), st[8u + i]);
        st[i]      = fp_add(st[i], s);
        st[4u + i] = fp_add(st[4u + i], s);
        st[8u + i] = fp_add(st[8u + i], s);
    }
}

void poseidon2_apply_mi(inout uint64_t st[12]) {
    uint64_t s = 0ul;
    for (uint i = 0u; i < 12u; ++i) {
        s = fp_add(s, st[i]);
    }
    st[0] = fp_add(fp_neg(fp_add(st[0], st[0])), s);
    st[1] = fp_add(st[1], s);
    for (uint i = 2u; i < 12u; ++i) {
        st[i] = fp_add(fp_shl_canonical(st[i], i - 1u), s);
    }
}

void main() {
    uint idx = pc.base_state + gl_GlobalInvocationID.x;
    if (idx >= pc.num_states) {
        return;
    }

    uint base = idx * 12u;
    uint64_t st[12];
    for (uint i = 0u; i < 12u; ++i) {
        st[i] = states_buf.words[base + i];
    }

    poseidon2_apply_me(st);
    for (uint r = 0u; r < 4u; ++r) {
        uint rc_base = r * 12u;
        for (uint lane = 0u; lane < 12u; ++lane) {
            st[lane] = poseidon2_sbox7(fp_add(st[lane], RC_EXT_INIT[rc_base + lane]));
        }
        poseidon2_apply_me(st);
    }
    for (uint r = 0u; r < 22u; ++r) {
        st[0] = poseidon2_sbox7(fp_add(st[0], RC_INT[r]));
        poseidon2_apply_mi(st);
    }
    for (uint r = 0u; r < 4u; ++r) {
        uint rc_base = r * 12u;
        for (uint lane = 0u; lane < 12u; ++lane) {
            st[lane] = poseidon2_sbox7(fp_add(st[lane], RC_EXT_TERM[rc_base + lane]));
        }
        poseidon2_apply_me(st);
    }

    for (uint i = 0u; i < 12u; ++i) {
        states_buf.words[base + i] = st[i];
    }
}
