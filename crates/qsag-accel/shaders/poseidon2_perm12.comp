#version 460
#extension GL_ARB_gpu_shader_int64 : require

// Certified SPIR-V compute kernel for `KernelSlot::BatchPoseidon2Perm12`.
// Executes canonical Width-12 Goldilocks (`p = 2^64 - 2^32 + 1`) Poseidon2 permutation
// (4 initial external + 22 internal partial + 4 terminal external rounds) in 64-bit VGPRs.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer StatesBuf {
    uint64_t words[];
} states_buf;

layout(push_constant) uniform PushConsts {
    uint num_states;
    uint base_state;
    uint _pad0;
    uint _pad1;
} pc;

const uint64_t GL_P   = 0xFFFFFFFF00000001ul;
const uint64_t GL_EPS = 0xFFFFFFFFul;

// Canonical SplitMix64-derived round constants reduced mod `GL_P` (`poseidon2_const_at`).
const uint64_t RC_EXT_INIT[48] = uint64_t[48](
    0xFDA3872AFF6CE05Dul, 0xED0FC745B9C6495Bul, 0x9D4A1D75CA56751Ful, 0x21478BBCDAD17885ul,
