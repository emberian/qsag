#version 460
#extension GL_ARB_gpu_shader_int64 : require

// Certified SPIR-V 1.5 compute kernel for `ProverKernelSlot::WhirFoldSumcheck`.
// VRAM-resident Kronecker table expansion (`monomial_table`, `eq_table`, `add_geometric_scaled`),
// univariate OOD evaluation, `dot_base_ext4`, `cur_coeffs` linear combination, batch point-reduction
// sumcheck rounds + folds, `prove_fold_in_place` passes A/B/C, and batched shift-claim accumulation.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Buf0 { uint64_t words[]; } b0;
layout(std430, set = 0, binding = 1) buffer Buf1 { uint64_t words[]; } b1;
layout(std430, set = 0, binding = 2) buffer Buf2 { uint64_t words[]; } b2;
layout(std430, set = 0, binding = 3) buffer Buf3 { uint64_t words[]; } b3;
layout(std430, set = 0, binding = 4) buffer Buf4 { uint64_t words[]; } b4;
layout(std430, set = 0, binding = 5) buffer Buf5 { uint64_t words[]; } b5;

// 128-byte push constants (fits 3 `Ext4` challenges `c0, c1, c2` = 96 bytes + 8 `u32` control words).
layout(push_constant) uniform PushConsts {
    u64vec4 c0;
    u64vec4 c1;
    u64vec4 c2;
    uint    mode;
    uint    len;
    uint    aux0;
    uint    aux1;
    uint    aux2;
    uint    aux3;
    uint    aux4;
    uint    aux5;
} pc;

const uint64_t GL_P   = 0xFFFFFFFF00000001ul;
const uint64_t GL_EPS = 0xFFFFFFFFul;

shared uint s_red[8][256];

u64vec4 red_load(uint i) {
    return u64vec4(
        uint64_t(s_red[0][i]) | (uint64_t(s_red[1][i]) << 32u),
        uint64_t(s_red[2][i]) | (uint64_t(s_red[3][i]) << 32u),
        uint64_t(s_red[4][i]) | (uint64_t(s_red[5][i]) << 32u),
        uint64_t(s_red[6][i]) | (uint64_t(s_red[7][i]) << 32u)
    );
}

void red_store(uint i, u64vec4 v) {
    s_red[0][i] = uint(v.x);
    s_red[1][i] = uint(v.x >> 32u);
    s_red[2][i] = uint(v.y);
    s_red[3][i] = uint(v.y >> 32u);
    s_red[4][i] = uint(v.z);
    s_red[5][i] = uint(v.z >> 32u);
    s_red[6][i] = uint(v.w);
    s_red[7][i] = uint(v.w >> 32u);
}

uint64_t fp_reduce_u64(uint64_t x) {
    return x - (GL_P & (0ul - uint64_t(x >= GL_P)));
}

uint64_t fp_add(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t rem_p = GL_P - b_c;
    uint64_t mask = 0ul - uint64_t(a_c < rem_p);
    return ((a_c + b_c) & mask) | ((a_c - rem_p) & ~mask);
}

uint64_t fp_sub(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t diff = a_c - b_c;
    return diff + (GL_P & (0ul - uint64_t(a_c < b_c)));
}

uint64_t fp_reduce128(uint64_t lo, uint64_t hi) {
    uint64_t hi_lo = hi & GL_EPS;
    uint64_t hi_hi = hi >> 32u;
    uint64_t mid = (hi_lo << 32u) - hi_lo;
    uint64_t lo_c = fp_reduce_u64(lo);
    return fp_sub(fp_add(lo_c, mid), hi_hi);
}

uint64_t fp_mul(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t a_lo = a_c & 0xFFFFFFFFul;
    uint64_t a_hi = a_c >> 32u;
    uint64_t b_lo = b_c & 0xFFFFFFFFul;
    uint64_t b_hi = b_c >> 32u;
    uint64_t p0 = a_lo * b_lo;
    uint64_t p1 = a_lo * b_hi;
    uint64_t p2 = a_hi * b_lo;
    uint64_t p3 = a_hi * b_hi;
    uint64_t mid = (p0 >> 32u) + (p1 & 0xFFFFFFFFul) + (p2 & 0xFFFFFFFFul);
    uint64_t lo = (p0 & 0xFFFFFFFFul) | (mid << 32u);
    uint64_t hi = p3 + (p1 >> 32u) + (p2 >> 32u) + (mid >> 32u);
    return fp_reduce128(lo, hi);
}

uint64_t fp_pow_u32(uint64_t base_val, uint exp) {
    uint64_t res = 1ul;
    uint64_t cur = fp_reduce_u64(base_val);
    uint e = exp;
    while (e != 0u) {
        if ((e & 1u) != 0u) {
            res = fp_mul(res, cur);
        }
        e >>= 1u;
        if (e != 0u) {
            cur = fp_mul(cur, cur);
        }
    }
    return res;
}

u64vec2 fp2_add(u64vec2 a, u64vec2 b) {
    return u64vec2(fp_add(a.x, b.x), fp_add(a.y, b.y));
}

u64vec2 fp2_sub(u64vec2 a, u64vec2 b) {
    return u64vec2(fp_sub(a.x, b.x), fp_sub(a.y, b.y));
}

u64vec2 fp2_mul_by_u(u64vec2 a) {
    return u64vec2(fp_mul(a.y, 7ul), a.x);
}

u64vec2 fp2_mul(u64vec2 a, u64vec2 b) {
    uint64_t a0b0 = fp_mul(a.x, b.x);
    uint64_t a1b1 = fp_mul(a.y, b.y);
    uint64_t mid = fp_sub(fp_sub(fp_mul(fp_add(a.x, a.y), fp_add(b.x, b.y)), a0b0), a1b1);
    return u64vec2(fp_add(a0b0, fp_mul(a1b1, 7ul)), mid);
}

u64vec4 fp4_add(u64vec4 a, u64vec4 b) {
    return u64vec4(fp_add(a.x, b.x), fp_add(a.y, b.y), fp_add(a.z, b.z), fp_add(a.w, b.w));
}

u64vec4 fp4_sub(u64vec4 a, u64vec4 b) {
    return u64vec4(fp_sub(a.x, b.x), fp_sub(a.y, b.y), fp_sub(a.z, b.z), fp_sub(a.w, b.w));
}

u64vec4 fp4_mul_base(u64vec4 a, uint64_t s) {
    return u64vec4(fp_mul(a.x, s), fp_mul(a.y, s), fp_mul(a.z, s), fp_mul(a.w, s));
}

u64vec4 fp4_mul(u64vec4 a, u64vec4 b) {
    u64vec2 v0 = fp2_mul(a.xy, b.xy);
    u64vec2 v1 = fp2_mul(a.zw, b.zw);
    u64vec2 mid = fp2_sub(fp2_sub(fp2_mul(fp2_add(a.xy, a.zw), fp2_add(b.xy, b.zw)), v0), v1);
    return u64vec4(fp2_add(v0, fp2_mul_by_u(v1)), mid);
}

u64vec4 load4_b0(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b0.words[o], b0.words[o + 1u], b0.words[o + 2u], b0.words[o + 3u]);
}
void store4_b0(uint idx, u64vec4 v) {
    uint o = idx * 4u;
    b0.words[o] = v.x; b0.words[o + 1u] = v.y; b0.words[o + 2u] = v.z; b0.words[o + 3u] = v.w;
}

u64vec4 load4_b1(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b1.words[o], b1.words[o + 1u], b1.words[o + 2u], b1.words[o + 3u]);
}
void store4_b1(uint idx, u64vec4 v) {
    uint o = idx * 4u;
    b1.words[o] = v.x; b1.words[o + 1u] = v.y; b1.words[o + 2u] = v.z; b1.words[o + 3u] = v.w;
}

u64vec4 load4_b2(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b2.words[o], b2.words[o + 1u], b2.words[o + 2u], b2.words[o + 3u]);
}
void store4_b2(uint idx, u64vec4 v) {
    uint o = idx * 4u;
    b2.words[o] = v.x; b2.words[o + 1u] = v.y; b2.words[o + 2u] = v.z; b2.words[o + 3u] = v.w;
}

u64vec4 load4_b3(uint idx) {
    uint o = idx * 4u;
    return u64vec4(b3.words[o], b3.words[o + 1u], b3.words[o + 2u], b3.words[o + 3u]);
}
void store4_b3(uint idx, u64vec4 v) {
    uint o = idx * 4u;
    b3.words[o] = v.x; b3.words[o + 1u] = v.y; b3.words[o + 2u] = v.z; b3.words[o + 3u] = v.w;
}

void store4_b5(uint idx, u64vec4 v) {
    uint o = idx * 4u;
    b5.words[o] = v.x; b5.words[o + 1u] = v.y; b5.words[o + 2u] = v.z; b5.words[o + 3u] = v.w;
}

u64vec4 wg_reduce_sum(uint lid, u64vec4 val) {
    red_store(lid, val);
    barrier();
    for (uint s = 128u; s >= 1u; s >>= 1u) {
        if (lid < s) {
            red_store(lid, fp4_add(red_load(lid), red_load(lid + s)));
        }
        barrier();
    }
    return red_load(0u);
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg_x = gl_WorkGroupID.x;
    uint wg_y = gl_WorkGroupID.y;
    uint gid = pc.aux5 + gl_GlobalInvocationID.x;

    if (pc.mode == 0u) {
        // 4-Byte Kronecker table expansion (`b0` = `1024 * num_tables` `Ext4`s):
        //   `pc.aux0 == 0`: write `b1[dst_base + t * dst_stride + gid] = val` (zeros at `len..len+pad`)
        //   `pc.aux0 == 1`: accumulate `b1[dst_base + gid] += val` (`add_geometric_scaled_in_place`)
        //   `pc.aux0 == 2`: OOD univariate eval `sum_i b2[src_base + i] * val` -> `b5[out_base + wg_x]`
        uint t = wg_y;
        uint sub_op = pc.aux0;
        uint num_tables = pc.aux1;
        uint dst_stride = pc.aux2;
        uint dst_base = pc.aux3;
        uint out_base = pc.aux4;

        u64vec4 prod = u64vec4(0ul);
        if (t < num_tables && gid < pc.len) {
            uint t_off = t * 1024u;
            uint k0 = gid & 255u;
            uint k1 = (gid >> 8u) & 255u;
            uint k2 = (gid >> 16u) & 255u;
            uint k3 = (gid >> 24u) & 255u;
            u64vec4 v0 = load4_b0(t_off + k0);
            u64vec4 v1 = load4_b0(t_off + 256u + k1);
            u64vec4 v2 = load4_b0(t_off + 512u + k2);
            u64vec4 v3 = load4_b0(t_off + 768u + k3);
            u64vec4 val = fp4_mul(fp4_mul(v0, v1), fp4_mul(v2, v3));

            if (sub_op == 0u) {
                // `c0.x` carries optional `core_len` when padding `+ 2` trailing zeros (`monomial_table`).
                uint core_limit = uint(pc.c0.x);
                u64vec4 to_write = (gid < core_limit) ? val : u64vec4(0ul);
                store4_b1(dst_base + t * dst_stride + gid, to_write);
                return;
            }
            if (sub_op == 1u) {
                uint idx = dst_base + gid;
                store4_b1(idx, fp4_add(load4_b1(idx), val));
                return;
            }
            // `sub_op == 2u`: univariate evaluation (`b2` = `cur_coeffs`).
            prod = fp4_mul(load4_b2(dst_base + gid), val);
        }
        if (sub_op == 2u && t < num_tables) {
            u64vec4 sum = wg_reduce_sum(lid, prod);
            if (lid == 0u) {
                store4_b5(out_base + t * gl_NumWorkGroups.x + wg_x, sum);
            }
        }
        return;
    }

    if (pc.mode == 1u) {
        // `dot_base_ext4` across `num_polys = pc.aux1` (`b0` = `vram_mono` `u64`s, `b1` = `kernel` `Ext4`s):
        // computes `sum_{i=0}^{len-1} mono[p * poly_stride + i] * kernel[k_base + i]`.
        uint p = wg_y;
        uint num_polys = pc.aux1;
        uint poly_stride = pc.aux2;
        uint k_base = pc.aux3;
        uint out_base = pc.aux4;
        u64vec4 term = u64vec4(0ul);
        if (p < num_polys && gid < pc.len) {
            uint64_t m = b0.words[p * poly_stride + gid];
            u64vec4 k = load4_b1(k_base + gid);
            term = fp4_mul_base(k, m);
        }
        if (p < num_polys) {
            u64vec4 sum = wg_reduce_sum(lid, term);
            if (lid == 0u) {
                store4_b5(out_base + p * gl_NumWorkGroups.x + wg_x, sum);
            }
        }
        return;
    }

    if (pc.mode == 2u) {
        // Build `cur_coeffs[0..core_len + 2]` (`b2` at `dst_base`) from `vram_mono` (`b0`):
        //   `pc.aux0 == 1`: single-poly lift `cur_coeffs[i] = (i < core_len) ? from_base(mono[i]) : 0`
        //   `pc.aux0 == 0`: batch weighted combination using `weights[0..num_polys]` (`2` `Ext4`s/poly in `b3`).
        uint core_len = pc.len;
        if (gid >= core_len + 2u) {
            return;
        }
        uint is_single = pc.aux0;
        uint num_polys = pc.aux1;
        uint poly_stride = pc.aux2;
        uint dst_base = pc.aux3;
        u64vec4 acc = u64vec4(0ul);
        if (is_single != 0u) {
            if (gid < core_len) {
                acc = u64vec4(fp_reduce_u64(b0.words[gid]), 0ul, 0ul, 0ul);
            }
        } else {
            for (uint p = 0u; p < num_polys; ++p) {
                u64vec4 w0 = load4_b3(2u * p);
                u64vec4 w1 = load4_b3(2u * p + 1u);
                uint p_off = p * poly_stride;
                if (gid < core_len) {
                    acc = fp4_add(acc, fp4_mul_base(w0, b0.words[p_off + gid]));
                }
                if (gid > 0u && gid <= core_len) {
                    acc = fp4_add(acc, fp4_mul_base(w1, b0.words[p_off + gid - 1u]));
                }
            }
        }
        store4_b2(dst_base + gid, acc);
        return;
    }

    if (pc.mode == 3u) {
        // Batch point-reduction sumcheck round evaluation across `num_polys = pc.aux1`:
        //   `pc.aux0 == 0`: Round 0 (`b0` = base-field `vram_witness`, `b1` = `Ext4` `kernels`, `b3` = `lambda_pows`)
        //   `pc.aux0 == 1`: Round >= 1 (`b2` = `Ext4` `tables`, `b1` = `Ext4` `kernels`, `b3` = `lambda_pows`)
        uint half_len = pc.len;
        uint is_ext4 = pc.aux0;
        uint num_polys = pc.aux1;
        uint poly_stride = pc.aux2;
        uint src_base = pc.aux3;
        uint out_base = pc.aux4;

        u64vec4 ev0 = u64vec4(0ul);
        u64vec4 ev2 = u64vec4(0ul);
        if (gid < half_len) {
            for (uint p = 0u; p < num_polys; ++p) {
                u64vec4 lam = load4_b3(p);
                uint k_idx0 = src_base + p * poly_stride + 2u * gid;
                u64vec4 k0 = load4_b1(k_idx0);
                u64vec4 k1 = load4_b1(k_idx0 + 1u);
                u64vec4 k2 = fp4_add(k1, fp4_sub(k1, k0));
                u64vec4 p0_term;
                u64vec4 p2_term;
                if (is_ext4 == 0u) {
                    uint w_idx0 = p * poly_stride + 2u * gid;
                    uint64_t w0 = b0.words[w_idx0];
                    uint64_t w1 = b0.words[w_idx0 + 1u];
                    uint64_t w2 = fp_add(w1, fp_sub(w1, w0));
                    p0_term = fp4_mul_base(k0, w0);
                    p2_term = fp4_mul_base(k2, w2);
                } else {
                    u64vec4 w0 = load4_b2(k_idx0);
                    u64vec4 w1 = load4_b2(k_idx0 + 1u);
                    u64vec4 w2 = fp4_add(w1, fp4_sub(w1, w0));
                    p0_term = fp4_mul(k0, w0);
                    p2_term = fp4_mul(k2, w2);
                }
                ev0 = fp4_add(ev0, fp4_mul(lam, p0_term));
                ev2 = fp4_add(ev2, fp4_mul(lam, p2_term));
            }
        }
        u64vec4 s0 = wg_reduce_sum(lid, ev0);
        barrier();
        u64vec4 s2 = wg_reduce_sum(lid, ev2);
        if (lid == 0u) {
            store4_b5(out_base + 2u * wg_x, s0);
            store4_b5(out_base + 2u * wg_x + 1u, s2);
        }
        return;
    }

    if (pc.mode == 4u) {
        // Batch point-reduction sumcheck fold (`chal = pc.c0`, LSB-first `2*gid` & `2*gid+1`):
        //   folds all `num_polys = pc.aux1` `tables` + `kernels` from `src_base` (`stride = pc.aux2`)
        //   into `dst_base` (`dst_stride = pc.len = half_len`).
        uint half_len = pc.len;
        if (gid >= half_len) {
            return;
        }
        uint is_ext4 = pc.aux0;
        uint num_polys = pc.aux1;
        uint src_stride = pc.aux2;
        uint src_base = pc.aux3;
        uint dst_base = pc.aux4;
        u64vec4 chal = pc.c0;

        for (uint p = 0u; p < num_polys; ++p) {
            uint s_idx = src_base + p * src_stride + 2u * gid;
            uint d_idx = dst_base + p * half_len + gid;

            u64vec4 k0 = load4_b1(s_idx);
            u64vec4 k1 = load4_b1(s_idx + 1u);
            store4_b1(d_idx, fp4_add(k0, fp4_mul(chal, fp4_sub(k1, k0))));

            if (is_ext4 == 0u) {
                uint w_idx = p * src_stride + 2u * gid;
                uint64_t w0 = fp_reduce_u64(b0.words[w_idx]);
                uint64_t w1 = fp_reduce_u64(b0.words[w_idx + 1u]);
                u64vec4 w_folded = fp4_add(u64vec4(w0, 0ul, 0ul, 0ul), fp4_mul_base(chal, fp_sub(w1, w0)));
                store4_b2(d_idx, w_folded);
            } else {
                u64vec4 w0 = load4_b2(s_idx);
                u64vec4 w1 = load4_b2(s_idx + 1u);
                store4_b2(d_idx, fp4_add(w0, fp4_mul(chal, fp4_sub(w1, w0))));
            }
        }
        return;
    }

    if (pc.mode == 5u) {
        // `prove_fold_in_place` Pass A: reduce `wire[0..3]` over `i < pairs_ck = pc.len`.
        // `b2` = `cur_c` at `c_base = pc.aux0`, `b1` = `cur_k` at `k_base = pc.aux1`.
        u64vec4 w0 = u64vec4(0ul);
        u64vec4 w1 = u64vec4(0ul);
        u64vec4 w2 = u64vec4(0ul);
        if (gid < pc.len) {
            uint ci = pc.aux0 + 2u * gid;
            uint ki = pc.aux1 + 2u * gid;
            u64vec4 c_even = load4_b2(ci);
            u64vec4 c_odd  = load4_b2(ci + 1u);
            u64vec4 k_even = load4_b1(ki);
            u64vec4 k_odd  = load4_b1(ki + 1u);
            w0 = fp4_mul(c_even, k_even);
            w1 = fp4_mul(c_even, k_odd);
            w2 = fp4_mul(c_odd, k_even);
        }
        u64vec4 s0 = wg_reduce_sum(lid, w0);
        barrier();
        u64vec4 s1 = wg_reduce_sum(lid, w1);
        barrier();
        u64vec4 s2 = wg_reduce_sum(lid, w2);
        if (lid == 0u) {
            uint o = pc.aux4 + 3u * wg_x;
            store4_b5(o,      s0);
            store4_b5(o + 1u, s1);
            store4_b5(o + 2u, s2);
        }
        return;
    }

    if (pc.mode == 6u) {
        // `prove_fold_in_place` Fused Pass B (`phi = pc.c0`):
        //   1) Writes `k_next[gid]` (`gid <= k_half = pc.aux2`) into `b1` at `k_dst = pc.aux3`.
        //   2) Reduces `wire[3..5]` over `gid < pairs_c = pc.len` (`c` in `b2` at `c_base = pc.aux0`,
        //      `k` in `b1` at `k_src = pc.aux1`).
        uint c_base = pc.aux0;
        uint k_src  = pc.aux1;
        uint k_half = pc.aux2;
        uint k_dst  = pc.aux3;
        uint out_base = pc.aux4;
        u64vec4 phi = pc.c0;

        if (gid < k_half) {
            uint ks = k_src + 2u * gid;
            u64vec4 kn = fp4_add(load4_b1(ks), fp4_mul(phi, load4_b1(ks + 1u)));
            store4_b1(k_dst + gid, kn);
        } else if (gid == k_half) {
            store4_b1(k_dst + k_half, u64vec4(0ul));
        }

        u64vec4 w3 = u64vec4(0ul);
        u64vec4 w4 = u64vec4(0ul);
        if (gid < pc.len && (gid + 1u) < k_half) {
            uint ks1 = k_src + 2u * (gid + 1u);
            u64vec4 kn1 = fp4_add(load4_b1(ks1), fp4_mul(phi, load4_b1(ks1 + 1u)));
            uint ci = c_base + 2u * gid;
            w3 = fp4_mul(load4_b2(ci), kn1);
            w4 = fp4_mul(load4_b2(ci + 1u), kn1);
        }
        u64vec4 s3 = wg_reduce_sum(lid, w3);
        barrier();
        u64vec4 s4 = wg_reduce_sum(lid, w4);
        if (lid == 0u) {
            uint o = out_base + 2u * wg_x;
            store4_b5(o,      s3);
            store4_b5(o + 1u, s4);
        }
        return;
    }

    if (pc.mode == 7u) {
        // `prove_fold_in_place` Pass C (`theta = pc.c0, alpha = pc.c1, beta = pc.c2`):
        //   Folds `cur_c` (`m = c_len / 2 = pc.len`, `c_src = pc.aux0`) -> `c_dst = pc.aux1` (`0..=m`).
        uint m = pc.len;
        if (gid > m) {
            return;
        }
        uint c_src = pc.aux0;
        uint c_dst = pc.aux1;
        u64vec4 theta = pc.c0;
        u64vec4 alpha = pc.c1;
        u64vec4 beta  = pc.c2;

        u64vec4 u_prev = u64vec4(0ul);
        if (gid > 0u) {
            uint cp = c_src + 2u * gid - 2u;
            u64vec4 c0p = load4_b2(cp);
            u64vec4 c1p = load4_b2(cp + 1u);
            u_prev = fp4_add(c0p, fp4_mul(theta, c1p));
        }
        u64vec4 u_curr = u64vec4(0ul);
        u64vec4 c_odd  = u64vec4(0ul);
        if (gid < m) {
            uint cc = c_src + 2u * gid;
            c_odd  = load4_b2(cc + 1u);
            u_curr = fp4_add(load4_b2(cc), fp4_mul(theta, c_odd));
        }
        u64vec4 res = fp4_add(fp4_mul(beta, u_prev), fp4_add(c_odd, fp4_mul(alpha, u_curr)));
        store4_b2(c_dst + gid, res);
        return;
    }

    if (pc.mode == 8u) {
        // Batched `accumulate_shift_claims_into_kernel`:
        //   `b1` = `cur_k` at `k_base = pc.aux0` (`len = pc.len`)
        //   `b3` = `z_pow_256[0 .. num_claims * 256]` (`u64`s)
        //   `b4` = `claims[0 .. num_claims]` (`2` `Ext4`s per claim: `[u64vec4(z_m,0,0,0), weight_m]`)
        uint num_claims = pc.aux1;
        uint k_base = pc.aux0;
        uint wg_base = (pc.aux5 + wg_x * 256u);
        u64vec4 acc = u64vec4(0ul);

        for (uint c_base = 0u; c_base < num_claims; c_base += 256u) {
            uint chunk = min(256u, num_claims - c_base);
            if (lid < chunk) {
                uint m = c_base + lid;
                uint o = m * 8u;
                uint64_t z_m = b4.words[o];
                u64vec4 w_m = u64vec4(b4.words[o + 4u], b4.words[o + 5u], b4.words[o + 6u], b4.words[o + 7u]);
                uint64_t z_wg = fp_pow_u32(z_m, wg_base);
                red_store(lid, fp4_mul_base(w_m, z_wg));
            }
            barrier();

            if (gid < pc.len) {
                for (uint j = 0u; j < chunk; ++j) {
                    u64vec4 w_wg = red_load(j);
                    uint64_t z_lo = b3.words[(c_base + j) * 256u + lid];
                    acc = fp4_add(acc, fp4_mul_base(w_wg, z_lo));
                }
            }
            barrier();
        }

        if (gid < pc.len) {
            uint ki = k_base + gid;
            store4_b1(ki, fp4_add(load4_b1(ki), acc));
        }
        return;
    }
}
