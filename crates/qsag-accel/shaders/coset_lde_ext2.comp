#version 460
#extension GL_ARB_gpu_shader_int64 : require

// Certified SPIR-V compute kernel for `KernelSlot::CosetLdeExt2`.
// VRAM-resident shifted-coset Reed-Solomon Low-Degree Extension over `F_{p^2} = F_p[u]/(u^2 - 7)`:
//   mode == 0: In-place canonical reduction + bit-reversal permutation on `u64vec2[0..len]`.
//   mode == 1: Fused 9-stage in-LDS `u64vec2` butterfly (`stages 1..=9`, `512` pairs/workgroup).
//   mode == 2: Single-stage VRAM `u64vec2` radix-2 butterfly (`stage = s`).
//   mode == 3: Fused `N^{-1} * shift^j` monomial coset scaling on `[0..aux_n)` + zero-pad `[aux_n..len)`.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer Ext2Buf {
    u64vec2 elems[];
} buf;

layout(push_constant) uniform PushConsts {
    uint64_t w_step;
    uint64_t shift_c;
    uint     len;
    uint     aux_n;
    uint     log2_len;
    uint     stage;
    uint     mode;
    uint     base_wg;
} pc;

const uint64_t GL_P   = 0xFFFFFFFF00000001ul;
const uint64_t GL_EPS = 0xFFFFFFFFul;

shared u64vec2 s_lds[512];

uint64_t fp_reduce_u64(uint64_t x) {
    return (x >= GL_P) ? (x - GL_P) : x;
}

uint64_t fp_add(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t rem_p = GL_P - b_c;
    return (a_c < rem_p) ? (a_c + b_c) : (a_c - rem_p);
}

uint64_t fp_sub(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t diff = a_c - b_c;
    return (a_c < b_c) ? (diff + GL_P) : diff;
}

uint64_t fp_reduce128(uint64_t lo, uint64_t hi) {
    uint64_t hi_lo = hi & GL_EPS;
    uint64_t hi_hi = hi >> 32;
    uint64_t mid = (hi_lo << 32) - hi_lo;
    uint64_t lo_c = fp_reduce_u64(lo);
    return fp_sub(fp_add(lo_c, mid), hi_hi);
}

uint64_t fp_mul(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t a_lo = a_c & 0xFFFFFFFFul;
    uint64_t a_hi = a_c >> 32;
    uint64_t b_lo = b_c & 0xFFFFFFFFul;
    uint64_t b_hi = b_c >> 32;
    uint64_t p0 = a_lo * b_lo;
    uint64_t p1 = a_lo * b_hi;
    uint64_t p2 = a_hi * b_lo;
    uint64_t p3 = a_hi * b_hi;
    uint64_t mid = (p0 >> 32) + (p1 & 0xFFFFFFFFul) + (p2 & 0xFFFFFFFFul);
    uint64_t lo = (p0 & 0xFFFFFFFFul) | (mid << 32);
    uint64_t hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
    return fp_reduce128(lo, hi);
}

uint64_t fp_sq(uint64_t a) {
    return fp_mul(a, a);
}

uint64_t fp_pow_u32(uint64_t base, uint exp) {
    uint64_t acc = 1ul;
    uint64_t cur = fp_reduce_u64(base);
    uint e = exp;
    while (e != 0u) {
        if ((e & 1u) != 0u) {
            acc = fp_mul(acc, cur);
        }
        e >>= 1u;
        if (e != 0u) {
            cur = fp_sq(cur);
        }
    }
    return acc;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg  = pc.base_wg + gl_WorkGroupID.x;
    uint gid = wg * 256u + lid;

    if (pc.mode == 0u) {
        if (gid >= pc.len) {
            return;
        }
        uint rev = (pc.log2_len == 0u) ? 0u : (bitfieldReverse(gid) >> (32u - pc.log2_len));
        if (gid < rev) {
            u64vec2 a = buf.elems[gid];
            u64vec2 b = buf.elems[rev];
            a = u64vec2(fp_reduce_u64(a.x), fp_reduce_u64(a.y));
            b = u64vec2(fp_reduce_u64(b.x), fp_reduce_u64(b.y));
            buf.elems[gid] = b;
            buf.elems[rev] = a;
        } else if (gid == rev) {
            u64vec2 a = buf.elems[gid];
            buf.elems[gid] = u64vec2(fp_reduce_u64(a.x), fp_reduce_u64(a.y));
        }
        return;
    }

    if (pc.mode == 1u) {
        if (wg >= (pc.len >> 9u)) {
            return;
        }
        uint base = wg * 512u;
        s_lds[lid]        = buf.elems[base + lid];
        s_lds[lid + 256u] = buf.elems[base + lid + 256u];
        barrier();

        uint64_t w_roots[10];
        w_roots[9] = pc.w_step;
        for (int s = 8; s >= 1; --s) {
            w_roots[s] = fp_sq(w_roots[s + 1]);
        }

        for (uint s = 1u; s <= 9u; ++s) {
            uint half_len = 1u << (s - 1u);
            uint j    = lid & (half_len - 1u);
            uint idx0 = ((lid >> (s - 1u)) << s) + j;
            uint idx1 = idx0 + half_len;
            uint64_t w = fp_pow_u32(w_roots[s], j);
            u64vec2 u  = s_lds[idx0];
            u64vec2 vr = s_lds[idx1];
            u64vec2 v  = u64vec2(fp_mul(vr.x, w), fp_mul(vr.y, w));
            s_lds[idx0] = u64vec2(fp_add(u.x, v.x), fp_add(u.y, v.y));
            s_lds[idx1] = u64vec2(fp_sub(u.x, v.x), fp_sub(u.y, v.y));
            barrier();
        }

        buf.elems[base + lid]        = s_lds[lid];
        buf.elems[base + lid + 256u] = s_lds[lid + 256u];
        return;
    }

    if (pc.mode == 2u) {
        uint half_n   = pc.len >> 1u;
        uint s        = pc.stage;
        uint half_len = 1u << (s - 1u);

        if (half_len >= 256u) {
            if (lid == 0u) {
                uint j_base = (wg * 256u) & (half_len - 1u);
                s_lds[0].x = fp_pow_u32(pc.w_step, j_base);
            }
            barrier();
            if (gid < half_n) {
                uint block = gid >> (s - 1u);
                uint j     = gid & (half_len - 1u);
                uint idx0  = (block << s) + j;
                uint idx1  = idx0 + half_len;
                uint64_t w = fp_mul(s_lds[0].x, fp_pow_u32(pc.w_step, lid));
                u64vec2 u  = buf.elems[idx0];
                u64vec2 vr = buf.elems[idx1];
                u64vec2 v  = u64vec2(fp_mul(vr.x, w), fp_mul(vr.y, w));
                buf.elems[idx0] = u64vec2(fp_add(u.x, v.x), fp_add(u.y, v.y));
                buf.elems[idx1] = u64vec2(fp_sub(u.x, v.x), fp_sub(u.y, v.y));
            }
        } else {
            if (gid < half_n) {
                uint block = gid >> (s - 1u);
                uint j     = gid & (half_len - 1u);
                uint idx0  = (block << s) + j;
                uint idx1  = idx0 + half_len;
                uint64_t w = fp_pow_u32(pc.w_step, j);
                u64vec2 u  = buf.elems[idx0];
                u64vec2 vr = buf.elems[idx1];
                u64vec2 v  = u64vec2(fp_mul(vr.x, w), fp_mul(vr.y, w));
                buf.elems[idx0] = u64vec2(fp_add(u.x, v.x), fp_add(u.y, v.y));
                buf.elems[idx1] = u64vec2(fp_sub(u.x, v.x), fp_sub(u.y, v.y));
            }
        }
        return;
    }

    if (pc.mode == 3u) {
        if (lid == 0u) {
            uint base_j = wg * 256u;
            s_lds[0].x = (base_j < pc.aux_n)
                ? fp_mul(pc.w_step, fp_pow_u32(pc.shift_c, base_j))
                : 0ul;
        }
        barrier();
        if (gid < pc.len) {
            if (gid < pc.aux_n) {
                uint64_t scale = fp_mul(s_lds[0].x, fp_pow_u32(pc.shift_c, lid));
                u64vec2 v = buf.elems[gid];
                buf.elems[gid] = u64vec2(fp_mul(v.x, scale), fp_mul(v.y, scale));
            } else {
                buf.elems[gid] = u64vec2(0ul, 0ul);
            }
        }
    }
}
