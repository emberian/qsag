#version 460
#extension GL_ARB_gpu_shader_int64 : require

// Certified SPIR-V compute kernel for `KernelSlot::Fp5CosetLde`.
// Pure-quintic `Fp5 = F_p[X]/(X^5 - 3)` and base-field Goldilocks (`p = 2^64 - 2^32 + 1`)
// shifted-coset LDE preparation, limb gather/scatter, and forward/reverse multilinear Moebius
// transforms:
//   mode == 0: Forward base-field multilinear Moebius (`hi -= lo`) fused low bits `0..pc.stage` (`<= 9`) in LDS.
//   mode == 1: Forward base-field multilinear Moebius (`hi -= lo`) single high bit `b = pc.stage`.
//   mode == 2: Base-field shifted-coset NTT prep (`dst[gid] = gid < coeff_len ? src[gid] * shift^gid : 0`).
//   mode == 3: `Fp5` limb extract + shifted-coset prep (`dst[gid] = gid < coeff_len ? src[5*gid + limb] * shift^gid : 0`).
//   mode == 4: `Fp5` limb scatter (`dst[5*gid + limb] = src[gid]`).
//   mode == 5: Reverse `Fp5` multilinear Moebius (`cell_weights_to_kernel`, `lo += hi`) fused low bits `0..pc.stage` (`<= 6`) in LDS.
//   mode == 6: Reverse `Fp5` multilinear Moebius (`cell_weights_to_kernel`, `lo += hi`) single high bit `b = pc.stage`.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer SrcBuf {
    uint64_t words[];
} src_buf;

layout(std430, set = 0, binding = 1) buffer DstBuf {
    uint64_t words[];
} dst_buf;

// Original coefficients survive all five limb transforms. Buffer A is also
// binding zero of the canonical in-place NTT pipeline.
layout(std430, set = 0, binding = 2) readonly buffer CoeffBuf {
    uint64_t words[];
} coeff_buf;

layout(push_constant) uniform PushConsts {
    uint64_t shift;
    uint     n;
    uint     coeff_len;
    uint     log2_n;
    uint     stage;
    uint     limb;
    uint     mode;
    uint     base_wg;
    uint     _pad;
} pc;

const uint64_t GL_P   = 0xFFFFFFFF00000001ul;
const uint64_t GL_EPS = 0xFFFFFFFFul;

shared uint s_lds[2][512];
shared uint s_tw[2][32];

uint lds_index(uint i) { return i ^ (((i >> 5u) & 1u) * 31u); }

uint64_t lds_load(uint i) {
    uint a = lds_index(i);
    return uint64_t(s_lds[0][a]) | (uint64_t(s_lds[1][a]) << 32u);
}

void lds_store(uint i, uint64_t v) {
    uint a = lds_index(i);
    s_lds[0][a] = uint(v);
    s_lds[1][a] = uint(v >> 32u);
}

uint64_t tw_load(uint i) {
    return uint64_t(s_tw[0][i]) | (uint64_t(s_tw[1][i]) << 32u);
}

void tw_store(uint i, uint64_t v) {
    s_tw[0][i] = uint(v);
    s_tw[1][i] = uint(v >> 32u);
}

uint64_t fp_reduce_u64(uint64_t x) {
    return x - (GL_P & (0ul - uint64_t(x >= GL_P)));
}

uint64_t fp_add(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t rem_p = GL_P - b_c;
    uint64_t mask = 0ul - uint64_t(a_c < rem_p);
    return ((a_c + b_c) & mask) | ((a_c - rem_p) & ~mask);
}

uint64_t fp_sub(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t diff = a_c - b_c;
    return diff + (GL_P & (0ul - uint64_t(a_c < b_c)));
}

uint64_t fp_reduce128(uint64_t lo, uint64_t hi) {
    uint64_t hi_lo = hi & GL_EPS;
    uint64_t hi_hi = hi >> 32;
    uint64_t mid = (hi_lo << 32) - hi_lo;
    uint64_t lo_c = fp_reduce_u64(lo);
    return fp_sub(fp_add(lo_c, mid), hi_hi);
}

uint64_t fp_mul(uint64_t a, uint64_t b) {
    uint64_t a_c = fp_reduce_u64(a);
    uint64_t b_c = fp_reduce_u64(b);
    uint64_t a_lo = a_c & 0xFFFFFFFFul;
    uint64_t a_hi = a_c >> 32;
    uint64_t b_lo = b_c & 0xFFFFFFFFul;
    uint64_t b_hi = b_c >> 32;
    uint64_t p0 = a_lo * b_lo;
    uint64_t p1 = a_lo * b_hi;
    uint64_t p2 = a_hi * b_lo;
    uint64_t p3 = a_hi * b_hi;
    uint64_t mid = (p0 >> 32) + (p1 & 0xFFFFFFFFul) + (p2 & 0xFFFFFFFFul);
    uint64_t lo = (p0 & 0xFFFFFFFFul) | (mid << 32);
    uint64_t hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
    return fp_reduce128(lo, hi);
}

uint64_t fp_sq(uint64_t a) {
    return fp_mul(a, a);
}

uint64_t fp_pow_u32(uint64_t base, uint exp) {
    uint64_t acc = 1ul;
    uint64_t cur = fp_reduce_u64(base);
    uint e = exp;
    while (e != 0u) {
        if ((e & 1u) != 0u) {
            acc = fp_mul(acc, cur);
        }
        e >>= 1u;
        if (e != 0u) {
            cur = fp_sq(cur);
        }
    }
    return acc;
}

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint wg  = pc.base_wg + gl_WorkGroupID.x;
    uint gid = wg * 256u + lid;

    if (pc.mode == 0u) {
        uint block_elems = 1u << pc.stage;
        uint num_blocks  = pc.n >> pc.stage;
        if (wg >= num_blocks) {
            return;
        }
        uint base = wg * block_elems;
        if (lid < block_elems) {
            lds_store(lid, fp_reduce_u64(dst_buf.words[base + lid]));
        }
        if (lid + 256u < block_elems) {
            lds_store(lid + 256u, fp_reduce_u64(dst_buf.words[base + lid + 256u]));
        }
        barrier();

        uint pairs = block_elems >> 1u;
        for (uint b = 0u; b < pc.stage; ++b) {
            if (lid < pairs) {
                uint stride = 1u << b;
                uint j      = lid & (stride - 1u);
                uint idx0   = ((lid >> b) << (b + 1u)) + j;
                uint idx1   = idx0 + stride;
                uint64_t lo = lds_load(idx0);
                uint64_t hi = lds_load(idx1);
                lds_store(idx1, fp_sub(hi, lo));
            }
            barrier();
        }

        if (lid < block_elems) {
            dst_buf.words[base + lid] = lds_load(lid);
        }
        if (lid + 256u < block_elems) {
            dst_buf.words[base + lid + 256u] = lds_load(lid + 256u);
        }
        return;
    }

    if (pc.mode == 1u) {
        uint half_n = pc.n >> 1u;
        if (gid >= half_n) {
            return;
        }
        uint stride = 1u << pc.stage;
        uint j      = gid & (stride - 1u);
        uint idx0   = ((gid >> pc.stage) << (pc.stage + 1u)) + j;
        uint idx1   = idx0 + stride;
        dst_buf.words[idx1] = fp_sub(dst_buf.words[idx1], dst_buf.words[idx0]);
        return;
    }

    if (pc.mode == 2u || pc.mode == 3u) {
        if (lid < 16u) {
            tw_store(lid, fp_pow_u32(pc.shift, lid));
        } else if (lid < 32u) {
            uint hi = lid - 16u;
            tw_store(16u + hi, fp_pow_u32(pc.shift, hi << 4u));
        } else if (lid == 32u) {
            lds_store(0u, fp_pow_u32(pc.shift, wg * 256u));
        }
        barrier();

        if (gid >= pc.n) {
            return;
        }
        if (gid < pc.coeff_len) {
            uint64_t p_lid = fp_mul(tw_load(lid & 15u), tw_load(16u + (lid >> 4u)));
            uint64_t p     = fp_mul(lds_load(0u), p_lid);
            uint64_t c = (pc.mode == 2u)
                ? coeff_buf.words[gid]
                : coeff_buf.words[gid * 5u + pc.limb];
            src_buf.words[gid] = fp_mul(c, p);
        } else {
            src_buf.words[gid] = 0ul;
        }
        return;
    }

    if (pc.mode == 4u) {
        if (gid < pc.n) {
            dst_buf.words[gid * 5u + pc.limb] = fp_reduce_u64(src_buf.words[gid]);
        }
        return;
    }

    if (pc.mode == 5u) {
        uint block_elems = 1u << pc.stage;
        uint num_blocks  = pc.n >> pc.stage;
        if (wg >= num_blocks) {
            return;
        }
        uint block_words = block_elems * 5u;
        uint base_w      = wg * block_words;
        if (lid < block_words) {
            lds_store(lid, fp_reduce_u64(dst_buf.words[base_w + lid]));
        }
        if (lid + 256u < block_words) {
            lds_store(lid + 256u, fp_reduce_u64(dst_buf.words[base_w + lid + 256u]));
        }
        barrier();

        uint pair_words = (block_elems >> 1u) * 5u;
        for (uint b = 0u; b < pc.stage; ++b) {
            if (lid < pair_words) {
                uint pair_idx = lid / 5u;
                uint l_idx    = lid - pair_idx * 5u;
                uint stride   = 1u << b;
                uint j        = pair_idx & (stride - 1u);
                uint e0       = ((pair_idx >> b) << (b + 1u)) + j;
                uint e1       = e0 + stride;
                uint64_t lo   = lds_load(e0 * 5u + l_idx);
                uint64_t hi   = lds_load(e1 * 5u + l_idx);
                lds_store(e0 * 5u + l_idx, fp_add(lo, hi));
            }
            barrier();
        }

        if (lid < block_words) {
            dst_buf.words[base_w + lid] = lds_load(lid);
        }
        if (lid + 256u < block_words) {
            dst_buf.words[base_w + lid + 256u] = lds_load(lid + 256u);
        }
        return;
    }

    if (pc.mode == 6u) {
        uint half_n = pc.n >> 1u;
        if (gid >= half_n) {
            return;
        }
        uint stride  = 1u << pc.stage;
        uint j       = gid & (stride - 1u);
        uint idx0    = ((gid >> pc.stage) << (pc.stage + 1u)) + j;
        uint idx1    = idx0 + stride;
        uint b0      = idx0 * 5u;
        uint b1      = idx1 * 5u;
        for (uint l = 0u; l < 5u; ++l) {
            dst_buf.words[b0 + l] = fp_add(
                dst_buf.words[b0 + l],
                dst_buf.words[b1 + l]
            );
        }
    }
}
