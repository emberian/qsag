def cred_and_hd_guards.MlDsaReleaseGate.try_release_z_share
  (self : cred_and_hd_guards.MlDsaReleaseGate)
  (checks : cred_and_hd_guards.MlDsaBarrierChecks) :
  Result (cred_and_hd_guards.MlDsaReleaseGate × (core.result.Result (Array
    Std.U8 32#usize) cred_and_hd_guards.CredHdGuardError))
  := do
  if self.aborted
  then
    let mdrg ←
      cred_and_hd_guards.abort_mldsa_gate self.session_id self.attempt
    ok (mdrg, core.result.Result.Err
      cred_and_hd_guards.CredHdGuardError.GateAbortedOrReleased)
  else
    if self.released
    then
      let mdrg ←
        cred_and_hd_guards.abort_mldsa_gate self.session_id self.attempt
      ok (mdrg, core.result.Result.Err
        cred_and_hd_guards.CredHdGuardError.GateAbortedOrReleased)
    else
      let b ← tower.ct_eq_bytes32 self.session_id checks.req_session_id
      if b
      then
        if self.attempt != checks.req_attempt
        then
          let mdrg ←
            cred_and_hd_guards.abort_mldsa_gate self.session_id self.attempt
          ok (mdrg, core.result.Result.Err
            cred_and_hd_guards.CredHdGuardError.AttemptMismatch)
        else
          if checks.z_norm_ok
          then
            if checks.r0_norm_ok
            then
              if checks.w1_match
              then
                if checks.u_com_bound
                then
                  let a := Array.repeat 32#usize 0#u8
                  ok ({ self with z_share_masked := a, released := true },
                    core.result.Result.Ok self.z_share_masked)
                else
                  let mdrg ←
                    cred_and_hd_guards.abort_mldsa_gate self.session_id
                      self.attempt
                  ok (mdrg, core.result.Result.Err
                    cred_and_hd_guards.CredHdGuardError.RejectionSamplingBarrierFailed)
              else
                let mdrg ←
                  cred_and_hd_guards.abort_mldsa_gate self.session_id
                    self.attempt
                ok (mdrg, core.result.Result.Err
                  cred_and_hd_guards.CredHdGuardError.RejectionSamplingBarrierFailed)
            else
              let mdrg ←
                cred_and_hd_guards.abort_mldsa_gate self.session_id
                  self.attempt
              ok (mdrg, core.result.Result.Err
                cred_and_hd_guards.CredHdGuardError.RejectionSamplingBarrierFailed)
          else
            let mdrg ←
              cred_and_hd_guards.abort_mldsa_gate self.session_id self.attempt
            ok (mdrg, core.result.Result.Err
              cred_and_hd_guards.CredHdGuardError.RejectionSamplingBarrierFailed)
      else
        let mdrg ←
          cred_and_hd_guards.abort_mldsa_gate self.session_id self.attempt
        ok (mdrg, core.result.Result.Err
          cred_and_hd_guards.CredHdGuardError.SessionIdMismatch)

