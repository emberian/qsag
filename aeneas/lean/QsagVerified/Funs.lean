def cred_and_hd_guards.HdCommittedZeroTest.verify_peer_opening
  (self : cred_and_hd_guards.HdCommittedZeroTest)
  (req_session_id : Array Std.U8 32#usize)
  (recomputed_peer_commitment : Array Std.U8 32#usize)
  (peer_residual : Std.U32) :
  Result (cred_and_hd_guards.HdCommittedZeroTest × (core.result.Result Unit
    cred_and_hd_guards.CredHdGuardError))
  := do
  if self.family_quarantined
  then
    let hczt ←
      cred_and_hd_guards.quarantine_hd_family self.session_id
        self.frozen_peer_commitment self.modulus_q
    ok (hczt, core.result.Result.Err
      cred_and_hd_guards.CredHdGuardError.FamilyQuarantined)
  else
    let b ← tower.ct_eq_bytes32 self.session_id req_session_id
    if b
    then
      match self.phase with
      | cred_and_hd_guards.HdZeroTestPhase.AwaitPeerCommitment =>
        let hczt ←
          cred_and_hd_guards.quarantine_hd_family self.session_id
            self.frozen_peer_commitment self.modulus_q
        ok (hczt, core.result.Result.Err
          cred_and_hd_guards.CredHdGuardError.InvalidHdPhaseTransition)
      | cred_and_hd_guards.HdZeroTestPhase.PeerCommitmentFrozen =>
        let hczt ←
          cred_and_hd_guards.quarantine_hd_family self.session_id
            self.frozen_peer_commitment self.modulus_q
        ok (hczt, core.result.Result.Err
          cred_and_hd_guards.CredHdGuardError.InvalidHdPhaseTransition)
      | cred_and_hd_guards.HdZeroTestPhase.LocalResidualOpened =>
        let b1 ←
          tower.ct_eq_bytes32 self.frozen_peer_commitment
            recomputed_peer_commitment
        if b1
        then
          if self.modulus_q = 0#u32
          then
            let hczt ←
              cred_and_hd_guards.quarantine_hd_family self.session_id
                self.frozen_peer_commitment self.modulus_q
            ok (hczt, core.result.Result.Err
              cred_and_hd_guards.CredHdGuardError.InvalidModulusOrResidualQuarantined)
          else
            if self.local_residual >= self.modulus_q
            then
              let hczt ←
                cred_and_hd_guards.quarantine_hd_family self.session_id
                  self.frozen_peer_commitment self.modulus_q
              ok (hczt, core.result.Result.Err
                cred_and_hd_guards.CredHdGuardError.InvalidModulusOrResidualQuarantined)
            else
              if peer_residual >= self.modulus_q
              then
                let hczt ←
                  cred_and_hd_guards.quarantine_hd_family self.session_id
                    self.frozen_peer_commitment self.modulus_q
                ok (hczt, core.result.Result.Err
                  cred_and_hd_guards.CredHdGuardError.InvalidModulusOrResidualQuarantined)
              else
                let i ← lift (UScalar.cast .U64 self.local_residual)
                let i1 ← lift (UScalar.cast .U64 peer_residual)
                let sum ← i + i1
                let q64 ← lift (UScalar.cast .U64 self.modulus_q)
                let i2 ← sum % q64
                if i2 != 0#u64
                then
                  let hczt ←
                    cred_and_hd_guards.quarantine_hd_family self.session_id
                      self.frozen_peer_commitment self.modulus_q
                  ok (hczt, core.result.Result.Err
                    cred_and_hd_guards.CredHdGuardError.HdZeroTestMismatchQuarantined)
                else
                  ok
                    ({
                       self
                         with
                         phase :=
                           cred_and_hd_guards.HdZeroTestPhase.VerifiedZero,
                         local_residual := 0#u32
                     }, core.result.Result.Ok ())
        else
          let hczt ←
            cred_and_hd_guards.quarantine_hd_family self.session_id
              self.frozen_peer_commitment self.modulus_q
          ok (hczt, core.result.Result.Err
            cred_and_hd_guards.CredHdGuardError.PeerCommitmentMismatchQuarantined)
      | cred_and_hd_guards.HdZeroTestPhase.VerifiedZero =>
        let hczt ←
          cred_and_hd_guards.quarantine_hd_family self.session_id
            self.frozen_peer_commitment self.modulus_q
        ok (hczt, core.result.Result.Err
          cred_and_hd_guards.CredHdGuardError.InvalidHdPhaseTransition)
      | cred_and_hd_guards.HdZeroTestPhase.FamilyQuarantined =>
        let hczt ←
          cred_and_hd_guards.quarantine_hd_family self.session_id
            self.frozen_peer_commitment self.modulus_q
        ok (hczt, core.result.Result.Err
          cred_and_hd_guards.CredHdGuardError.InvalidHdPhaseTransition)
    else
      let hczt ←
        cred_and_hd_guards.quarantine_hd_family self.session_id
