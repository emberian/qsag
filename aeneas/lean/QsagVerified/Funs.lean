    Source: 'src/tower.rs', lines 71:0-76:1 -/
def tower.diff_bytes8
  (a : Array Std.U8 32#usize) (b : Array Std.U8 32#usize) (base : Std.Usize) :
  Result Std.U8
  := do
  let i ← Array.index_usize a base
  let i1 ← Array.index_usize b base
  let i2 ← lift (i ^^^ i1)
  let i3 ← base + 1#usize
  let i4 ← Array.index_usize a i3
  let i5 ← Array.index_usize b i3
  let i6 ← lift (i4 ^^^ i5)
  let i7 ← lift (i2 ||| i6)
  let i8 ← base + 2#usize
  let i9 ← Array.index_usize a i8
  let i10 ← Array.index_usize b i8
  let i11 ← lift (i9 ^^^ i10)
  let i12 ← base + 3#usize
  let i13 ← Array.index_usize a i12
  let i14 ← Array.index_usize b i12
  let i15 ← lift (i13 ^^^ i14)
  let i16 ← lift (i11 ||| i15)
  let i17 ← lift (i7 ||| i16)
  let i18 ← base + 4#usize
  let i19 ← Array.index_usize a i18
  let i20 ← Array.index_usize b i18
  let i21 ← lift (i19 ^^^ i20)
  let i22 ← base + 5#usize
  let i23 ← Array.index_usize a i22
  let i24 ← Array.index_usize b i22
  let i25 ← lift (i23 ^^^ i24)
  let i26 ← lift (i21 ||| i25)
  let i27 ← lift (i17 ||| i26)
  let i28 ← base + 6#usize
  let i29 ← Array.index_usize a i28
  let i30 ← Array.index_usize b i28
  let i31 ← lift (i29 ^^^ i30)
  let i32 ← base + 7#usize
  let i33 ← Array.index_usize a i32
  let i34 ← Array.index_usize b i32
  let i35 ← lift (i33 ^^^ i34)
  let i36 ← lift (i31 ||| i35)
  ok (i27 ||| i36)

/-- [qsag_verified::tower::ct_eq_bytes32]:
    Source: 'src/tower.rs', lines 80:0-84:1
    Visibility: public -/
def tower.ct_eq_bytes32
  (a : Array Std.U8 32#usize) (b : Array Std.U8 32#usize) : Result Bool := do
  let i ← tower.diff_bytes8 a b 0#usize
  let i1 ← tower.diff_bytes8 a b 8#usize
  let i2 ← lift (i ||| i1)
  let i3 ← tower.diff_bytes8 a b 16#usize
  let i4 ← tower.diff_bytes8 a b 24#usize
  let i5 ← lift (i3 ||| i4)
  let d ← lift (i2 ||| i5)
  ok (d = 0#u8)

