  (self : authenticated_belt.VerifiedBeltQuorumGuard) (epoch : Std.U64)
  (msg : Array Std.U8 32#usize) (receipt_digest : Array Std.U8 32#usize)
  (receipt_tag : Array Std.U8 32#usize) :
  Result (authenticated_belt.VerifiedBeltQuorumGuard × (core.result.Result
    Unit authenticated_belt.BeltAuthError))
