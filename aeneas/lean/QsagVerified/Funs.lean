def pants_and_quorum_guards.wotsc256_extract_digit
  (digest : Array Std.U8 32#usize) (chain_idx : Std.Usize) :
  Result Std.U8
  := do
  let i ← chain_idx / 4#usize
  let b ← Array.index_usize digest i
  let i1 ← chain_idx % 4#usize
  match i1.val with
  | 0 => let i2 ← b >>> 6#i32
         ok (i2 &&& 3#u8)
  | 1 => let i2 ← b >>> 4#i32
         ok (i2 &&& 3#u8)
  | 2 => let i2 ← b >>> 2#i32
         ok (i2 &&& 3#u8)
  | _ => ok (b &&& 3#u8)

