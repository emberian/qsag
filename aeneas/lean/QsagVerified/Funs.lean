          let i2 ← lift (UScalar.cast .U64 n)
          let i3 ← lift (UScalar.cast .U64 f)
          let n_plus_f ← i2 + i3
          if two_q <= n_plus_f
          then ok false
          else
            if require_global_liveness
            then let i4 ← n - f
                 if q > i4
                 then ok false
                 else ok true
            else ok true

