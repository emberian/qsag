/-- [qsag_verified::cred_and_hd_guards::toprf_majority_of_3_goldilocks]:
    Source: 'src/cred_and_hd_guards.rs', lines 211:0-245:1
    Visibility: public -/
def cred_and_hd_guards.toprf_majority_of_3_goldilocks
  (s0 : Std.U64) (s1 : Std.U64) (s2 : Std.U64) :
  Result (Option (Std.U64 × (Option Std.U8)))
  := do
  let c0 ← if s0 < goldilocks.GOLDILOCKS_PRIME
             then ok true
             else ok false
  let c1 ← if s1 < goldilocks.GOLDILOCKS_PRIME
             then ok true
             else ok false
  let c2 ← if s2 < goldilocks.GOLDILOCKS_PRIME
             then ok true
             else ok false
  let eq01 ←
    if c0
    then if c1
         then if s0 = s1
              then ok true
              else ok false
         else ok false
    else ok false
  let eq02 ←
    if c0
    then if c2
         then if s0 = s2
              then ok true
              else ok false
         else ok false
    else ok false
  let eq12 ←
    if c1
    then if c2
         then if s1 = s2
              then ok true
              else ok false
         else ok false
    else ok false
  if eq01
  then
    if eq02
    then ok (some (s0, none))
    else
      if eq01
      then ok (some (s0, some 2#u8))
      else
        if eq02
        then ok (some (s0, some 1#u8))
        else if eq12
             then ok (some (s1, some 0#u8))
             else ok none
  else
    if eq01
    then ok (some (s0, some 2#u8))
    else
      if eq02
      then ok (some (s0, some 1#u8))
      else if eq12
           then ok (some (s1, some 0#u8))
           else ok none

