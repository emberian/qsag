        ack_epoch ack_msg_tag custodian_id auth_tag
    match result with
    | core.result.Result.Ok n =>
      ok (next, core.result.Result.Ok
        (authenticated_belt.BeltQuorumStepOutput.AckRecorded n))
    | core.result.Result.Err e => ok (next, core.result.Result.Err e)
