  let expected ←
    authenticated_belt.wal_receipt_tag self.wal_key self.guard_key_commit epoch
      msg receipt_digest
  let valid ← tower.ct_eq_bytes32 expected receipt_tag
  let b ←
    pants_and_quorum_guards.BeltQuorumCore.impl.has_bound_epoch self.inner
  let same ←
    if b
    then
      do
      let i ←
        pants_and_quorum_guards.BeltQuorumCore.impl.bound_epoch self.inner
      if i = epoch
      then ok true
      else ok false
