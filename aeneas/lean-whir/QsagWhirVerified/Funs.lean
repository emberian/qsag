    Source: 'src/lib.rs', lines 565:0-593:1
    Visibility: public -/
def checked_quorum_sum
  (counts : Slice Std.U64) (minimums : Slice Std.U64)
  (minimum_global : Std.U64) :
  Result (Option Std.U64)
  := do
  let b ← core.slice.Slice.is_empty counts
  if b
  then ok none
  else
    let i := Slice.len counts
    let i1 := Slice.len minimums
    if i != i1
    then ok none
    else
      if minimum_global = 0#u64
      then ok none
      else
        checked_quorum_sum_loop counts minimums minimum_global 0#u64 0#u64
          0#usize

