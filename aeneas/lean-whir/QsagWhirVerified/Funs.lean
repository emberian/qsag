    Visibility: public -/
@[rust_loop_body]
def checked_quorum_sum_loop.body
  (counts : Slice Std.U64) (minimums : Slice Std.U64)
  (minimum_global : Std.U64) (total : Std.U64) (min_total : Std.U64)
  (i : Std.Usize) :
  Result (ControlFlow (Std.U64 × Std.U64 × Std.Usize) (Option Std.U64))
  := do
  let i1 := Slice.len counts
  if i < i1
  then
    let c ← Slice.index_usize counts i
    let m ← Slice.index_usize minimums i
    if m = 0#u64
    then ok (done none)
    else
      if c < m
      then ok (done none)
      else
        let i2 ← MAX_U64_WORD - c
        if total > i2
        then ok (done none)
        else
          let total1 ← total + c
          let i3 ← MAX_U64_WORD - m
          if min_total > i3
          then ok (done none)
          else
            let min_total1 ← min_total + m
            let i4 ← i + 1#usize
            ok (cont (total1, min_total1, i4))
  else
    if total < minimum_global
    then ok (done none)
    else ok (done (some total))

