def step_merkle_pair_order_400
  (idx : Std.U64) (level : Std.U32) (node : Array Std.U8 50#usize)
  (sibling : Array Std.U8 50#usize) :
  Result (Option MerklePair400)
  := do
  if level >= 64#u32
  then ok none
  else
    let i ← idx >>> level
    let i1 ← lift (i &&& 1#u64)
    if i1 = 0#u64
