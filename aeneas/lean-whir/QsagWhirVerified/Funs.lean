  (minimum_global : Std.U64) (total : Std.U64) (min_total : Std.U64)
  (i : Std.Usize) :
  Result (Option Std.U64)
  := do
  loop
    (fun (total1, min_total1, i1) => checked_quorum_sum_loop.body counts
      minimums minimum_global total1 min_total1 i1)
    (total, min_total, i)

